+    private fun boostSaturation(color: Int, amount: Float = 0.20f): Int {
+        val hsv = FloatArray(3)
+        Color.colorToHSV(color, hsv)
+        hsv[1] = (hsv[1] + amount).coerceAtMost(1.0f)
+        return Color.HSVToColor(hsv)
+    }
