+                    launch {
+                        ambientViewModel.rootViewTapPosition.collect { point ->
+                            val rect = Rect()
+                            ambientContainer.getHitRect(rect)
+                            if (!rect.contains(point.x, point.y)) {
+                                ambientContainer.collapseIfExpanded()
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
