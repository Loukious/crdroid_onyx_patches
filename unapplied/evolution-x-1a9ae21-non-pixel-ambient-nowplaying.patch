+            lyricsFetcher.addCallback(lyricsCallback)
+        } else if (!enabled && lyricsCallbackRegistered) {
+            lyricsCallbackRegistered = false
+            lyricsFetcher.removeCallback(lyricsCallback)
+            ambientContainer.setLyricLine(null)
+        }
+    }
