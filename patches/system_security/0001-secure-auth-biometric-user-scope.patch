+#[cfg(test)]
+mod biometric_scope_tests {
+    use super::*;
+    use android_hardware_security_secureclock::aidl::android::hardware::security::secureclock::Timestamp::Timestamp;
+
+    fn token(user_sid: i64) -> HardwareAuthToken {
+        HardwareAuthToken {
+            challenge: 17, userId: user_sid, authenticatorId: 555,
+            authenticatorType: HardwareAuthenticatorType::FINGERPRINT,
+            timestamp: Timestamp { milliSeconds: 1 }, mac: vec![7; 32],
+        }
+    }
+    fn receiver(request: &Arc<AuthRequest>, user: i32) -> TokenReceiver {
+        TokenReceiver { req: Arc::downgrade(request), user: AndroidUserId(user),
+            sids: vec![SecureUserId(555)], auth_type: HardwareAuthenticatorType::FINGERPRINT }
+    }
+    #[test]
+    fn foreign_scoped_token_cannot_fulfil_or_remove_pending_operation() {
+        let map = TokenReceiverMap::default();
+        let request = AuthRequest::op_auth();
+        map.add_receiver(Challenge(17), receiver(&request, 0));
+        map.add_auth_token(token(110), Some(&[10]));
+        assert!(request.get_auth_tokens().is_err());
+        assert!(map.map_and_cleanup_counter.lock().unwrap().0.contains_key(&Challenge(17)));
+        let own = token(99);
+        map.add_auth_token(own.clone(), Some(&[0]));
+        let received = request.get_auth_tokens().unwrap().0;
+        assert_eq!(received.userId, own.userId);
+        assert_eq!(received.authenticatorId, own.authenticatorId);
+        assert_eq!(received.mac, own.mac);
+    }
+    #[test]
+    fn unscoped_biometric_token_does_not_fulfil_pending_operation() {
+        let map = TokenReceiverMap::default();
+        let request = AuthRequest::op_auth();
+        map.add_receiver(Challenge(17), receiver(&request, 0));
+        map.add_auth_token(token(99), None);
+        assert!(request.get_auth_tokens().is_err());
+    }
+    #[test]
+    fn scoped_parent_token_can_fulfil_its_native_profile_operation() {
+        let map = TokenReceiverMap::default();
+        let request = AuthRequest::op_auth();
+        map.add_receiver(Challenge(17), receiver(&request, 11));
+        map.add_auth_token(token(110), Some(&[10, 11]));
+        assert_eq!(request.get_auth_tokens().unwrap().0.userId, 110);
+    }
+}
