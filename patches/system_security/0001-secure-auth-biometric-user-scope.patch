diff --git a/keystore2/src/biometric_user_scope.rs b/keystore2/src/biometric_user_scope.rs
new file mode 100644
index 0000000..df952b5
--- /dev/null
+++ b/keystore2/src/biometric_user_scope.rs
@@ -0,0 +1,59 @@
+// Copyright (C) 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+
+//! Logical user scope is additional metadata; signed hardware tokens remain unchanged.
+
+/// Biometric tokens require an explicit native user/profile scope, even when SIDs match.
+pub(crate) fn permits_user(authenticator_type: i32, users: Option<&[i32]>, user: i32) -> bool {
+    if user < 0 {
+        return false;
+    }
+    match users {
+        Some(users) => users.contains(&user),
+        None => authenticator_type & 2 == 0,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::permits_user;
+
+    #[test]
+    fn shared_authenticator_id_does_not_cross_user_scope() {
+        assert!(permits_user(2, Some(&[10]), 10));
+        assert!(!permits_user(2, Some(&[10]), 0));
+        assert!(!permits_user(2, Some(&[0]), 10));
+    }
+    #[test]
+    fn native_profile_scope_is_retained_without_other_full_users() {
+        assert!(permits_user(2, Some(&[10, 11]), 11));
+        assert!(!permits_user(2, Some(&[10, 11]), 0));
+        assert!(!permits_user(2, Some(&[10, 11]), 12));
+    }
+    #[test]
+    fn unscoped_biometric_tokens_fail_closed() {
+        assert!(!permits_user(2, None, 0));
+        assert!(!permits_user(2, None, 10));
+    }
+    #[test]
+    fn legacy_password_tokens_still_require_native_sid_validation() {
+        assert!(permits_user(1, None, 0));
+        assert!(permits_user(1, None, 10));
+    }
+    #[test]
+    fn mixed_authenticator_types_cannot_escape_biometric_scope() {
+        assert!(!permits_user(3, None, 0));
+        assert!(permits_user(3, Some(&[0]), 0));
+        assert!(!permits_user(3, Some(&[0]), 10));
+    }
+    #[test]
+    fn explicit_empty_scope_authorizes_no_user() {
+        assert!(!permits_user(2, Some(&[]), 0));
+        assert!(!permits_user(1, Some(&[]), 0));
+    }
+    #[test]
+    fn invalid_namespace_is_never_authorized() {
+        assert!(!permits_user(1, None, -1));
+        assert!(!permits_user(2, Some(&[-1]), -1));
+    }
+}
