+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.kotlin.mock
+
+@SmallTest
+@RunWith(AndroidJUnit4::class)
+class BrightnessSliderMirrorTouchTest : SysuiTestCase() {
+    @get:Rule val composeRule = createComposeRule()
+
+    private val screen = TestScreenBrightnessInteractor()
+    private val mirror = DelayedMirrorInteractor()
+    private var mirrorRetrieved = false
+
+    private fun create(supportsMirroring: Boolean = true) =
+        BrightnessSliderViewModel(
+            screenBrightnessInteractor = screen,
+            brightnessPolicyEnforcementInteractor =
+                object : BrightnessPolicyEnforcementInteractor {
+                    override val brightnessPolicyRestriction = emptyFlow<PolicyRestriction>()
+                    override fun startAdminSupportDetailsDialog(
+                        restriction: PolicyRestriction.Restricted
+                    ) {}
+                },
+            hapticsViewModelFactory = mock(),
+            brightnessMirrorShowingInteractorLazy = {
+                mirrorRetrieved = true
+                mirror
+            },
+            falsingInteractor = mock(),
+            supportsMirroring = supportsMirroring,
+            brightnessWarningToast = mock(),
+            msdlPlayer = mock(),
+        )
+
+    @Test
+    fun releasedDrag_acceptsModeTapWithoutRecompositionWhileMirrorStillVisible() {
+        val viewModel = create()
+        composeRule.setContent {
+            Box(
+                Modifier.brightnessMirrorGestureGate(viewModel) {
+                    viewModel.shouldBlockTouchesForMirror
+                }
+            ) {
+                Box(Modifier.size(80.dp).testTag("auto").clickable(onClick = viewModel::onIconClick))
+            }
+        }
+
+        // Keep the installed pointer handler unchanged while drag state changes.
+        composeRule.mainClock.autoAdvance = false
+
+        composeRule.runOnIdle { viewModel.setIsDragging(true) }
+        composeRule.onNodeWithTag("auto").performTouchInput { click() }
+        composeRule.runOnIdle {
+            assertThat(screen.modeToggles).isEqualTo(0)
+            viewModel.setIsDragging(false)
+            // The legacy shade keeps the mirror visible until its alpha animation finishes.
+            assertThat(mirror.isShowing.value).isTrue()
+            assertThat(viewModel.shouldBlockTouchesForMirror).isFalse()
+        }
+        composeRule.onNodeWithTag("auto").performTouchInput { click() }
+        composeRule.runOnIdle {
+            assertThat(screen.modeToggles).isEqualTo(1)
+            assertThat(screen.isAutoBrightnessEnabledFlow.value).isTrue()
+            assertThat(mirror.isShowing.value).isTrue()
+        }
+
+        // A second drag during the fade must restore the blocker for new touches.
+        composeRule.runOnIdle { viewModel.setIsDragging(true) }
+        composeRule.onNodeWithTag("auto").performTouchInput { click() }
+        composeRule.runOnIdle {
+            assertThat(screen.modeToggles).isEqualTo(1)
+            viewModel.setIsDragging(false)
+        }
+        composeRule.onNodeWithTag("auto").performTouchInput { click() }
+        composeRule.runOnIdle { assertThat(screen.modeToggles).isEqualTo(2) }
+        composeRule.mainClock.autoAdvance = true
+    }
+
+    @Test
+    fun gestureThatStartsDrag_remainsAllowedUntilRelease() {
+        val viewModel = create()
+        var completedDrags = 0
+        var canceledDrags = 0
+        var dragUpdates = 0
+        composeRule.setContent {
+            Box(
+                Modifier.brightnessMirrorGestureGate(viewModel) {
+                    viewModel.shouldBlockTouchesForMirror
+                }
+            ) {
+                Box(
+                    Modifier.size(200.dp).testTag("drag").pointerInput(viewModel) {
+                        detectDragGestures(
+                            onDragStart = { viewModel.setIsDragging(true) },
+                            onDragEnd = {
+                                viewModel.setIsDragging(false)
+                                completedDrags++
+                            },
+                            onDragCancel = { canceledDrags++ },
+                        ) { change, _ ->
+                            change.consume()
+                            dragUpdates++
+                        }
+                    }
+                )
+            }
+        }
+
+        composeRule.onNodeWithTag("drag").performTouchInput {
+            swipe(
+                start = centerLeft + Offset(10f, 0f),
+                end = centerRight - Offset(10f, 0f),
+                durationMillis = 220,
+            )
+        }
+        composeRule.runOnIdle {
+            assertThat(dragUpdates).isGreaterThan(1)
+            assertThat(completedDrags).isEqualTo(1)
+            assertThat(canceledDrags).isEqualTo(0)
+            assertThat(viewModel.isDragging).isFalse()
+        }
+    }
+
+    @Test
+    fun unsupportedMirroring_doesNotBlockTouchesOrRetrieveMirror() {
+        val viewModel = create(supportsMirroring = false)
+        viewModel.setIsDragging(true)
+        assertThat(viewModel.isDragging).isTrue()
+        assertThat(viewModel.shouldBlockTouchesForMirror).isFalse()
+        viewModel.setIsDragging(false)
+        assertThat(viewModel.isDragging).isFalse()
+        assertThat(mirrorRetrieved).isFalse()
+    }
+
+    private class DelayedMirrorInteractor : BrightnessMirrorShowingInteractor {
+        override val isShowing = MutableStateFlow(false)
+
+        override fun setMirrorShowing(showing: Boolean) {
+            if (showing) isShowing.value = true
+            // A false request intentionally waits for the shade's animation-end callback.
+        }
+    }
+
+    private class TestScreenBrightnessInteractor : ScreenBrightnessInteractor {
+        override val maxGammaBrightness = GammaBrightness(65535)
+        override val minGammaBrightness = GammaBrightness(0)
+        override val gammaBrightness = MutableStateFlow(GammaBrightness(1))
+        override val brightnessOverriddenByWindow = MutableStateFlow(false)
+        override val isAutoBrightnessEnabledFlow = MutableStateFlow(false)
+        var modeToggles = 0
+
+        override suspend fun setTemporaryBrightness(gammaBrightness: GammaBrightness) {}
+        override suspend fun setBrightness(gammaBrightness: GammaBrightness) {}
+
+        override fun toggleBrightnessMode() {
+            modeToggles++
+            isAutoBrightnessEnabledFlow.value = !isAutoBrightnessEnabledFlow.value
+        }
+    }
+}
