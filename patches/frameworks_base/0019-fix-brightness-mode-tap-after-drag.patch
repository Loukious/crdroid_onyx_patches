+/** Block new gestures during a mirror drag, while allowing the gesture that started the drag. */
+internal fun Modifier.brightnessMirrorGestureGate(
+    owner: Any,
+    shouldBlock: () -> Boolean,
+): Modifier = pointerInput(owner) {
+    awaitEachGesture {
+        awaitFirstDown(requireUnconsumed = false, pass = PointerEventPass.Initial)
+        val blockGesture = shouldBlock()
+        if (blockGesture) currentEvent.changes.forEach { it.consume() }
+        while (currentEvent.changes.any { it.pressed }) {
+            val event = awaitPointerEvent(PointerEventPass.Initial)
+            if (blockGesture) event.changes.forEach { it.consume() }
+        }
+    }
+}
