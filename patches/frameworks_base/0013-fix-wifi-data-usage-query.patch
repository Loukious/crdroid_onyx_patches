+    @WorkerThread
+    private fun queryWifiUsage(weekly: Boolean): String? {
+        // A denied permission/app-op is an expected state, not a failing remote
+        // query to repeat on every refresh. The service still enforces access.
+        val canQueryNetwork =
+            PermissionChecker.checkSelfPermissionForPreflight(
+                context, Manifest.permission.ACCESS_FINE_LOCATION
+            ) == PermissionChecker.PERMISSION_GRANTED
+        val template = duc.getWifiNetworkTemplate(canQueryNetwork)
+        val networkSpecific = template.wifiNetworkKeys.isNotEmpty()
+        val wifiLabel = context.getString(R.string.usage_wifi_default_suffix)
+        val suffix = if (networkSpecific) ssidWithTruncation() else wifiLabel
+        val info = if (weekly) duc.getWeeklyDataUsageInfo(template)
+                   else duc.getDailyDataUsageInfo(template)
+        if (info != null) {
+            return formatDataUsage(info.usageLevel, suffix, weekly)
+        }
+        if (!networkSpecific) return null
+
+        val aggregate = if (weekly) duc.getWifiWeeklyDataUsageInfo(false)
+                        else duc.getWifiDailyDataUsageInfo(false)
+        return aggregate?.let { formatDataUsage(it.usageLevel, wifiLabel, weekly) }
+    }
