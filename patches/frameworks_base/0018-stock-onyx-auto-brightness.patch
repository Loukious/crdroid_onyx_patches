+                    } finally {
+                        finishInputEvent(event, false);
+                    }
+                }
+            };
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Unable to monitor ALS cover touches", e);
+            if (mInputMonitor != null) mInputMonitor.dispose();
+            mInputMonitor = null;
+        }
+    }
+
+    private void onTouch(MotionEvent event) {
+        updateTouchRect();
+        boolean touching = false;
+        int action = event.getActionMasked();
+        if (action != MotionEvent.ACTION_UP && action != MotionEvent.ACTION_CANCEL) {
+            for (int i = 0; i < event.getPointerCount(); i++) {
+                if (action == MotionEvent.ACTION_POINTER_UP && i == event.getActionIndex()) continue;
+                if (mTouchRect.contains(Math.round(event.getX(i)), Math.round(event.getY(i)))) {
+                    touching = true;
+                    break;
+                }
+            }
+        }
+        mPolicy.setTouch(touching, now(), mConfig.touchDebounce);
+        scheduleUpdate();
+    }
+
+    private void updateTouchRect() {
+        mTouchRect.setEmpty();
+        Display display = mDisplayManager.getDisplay(Display.DEFAULT_DISPLAY);
+        if (display == null) return;
+        DisplayInfo info = new DisplayInfo();
+        if (!display.getDisplayInfo(info)) return;
+        // The stock rectangle is in native panel pixels and protects only landscape rotations.
+        int physicalWidth = display.getMode().getPhysicalWidth();
+        int physicalHeight = display.getMode().getPhysicalHeight();
+        Rect border = mConfig.touchRect;
+        if (info.rotation == Surface.ROTATION_90) {
+            mTouchRect.set(border.top, physicalWidth - border.right, border.bottom,
+                    physicalWidth - border.left);
+        } else if (info.rotation == Surface.ROTATION_270) {
+            mTouchRect.set(physicalHeight - border.bottom, border.left,
+                    physicalHeight - border.top, border.right);
+        } else {
+            return;
+        }
+        mTouchRect.scale((float) info.logicalHeight / physicalWidth);
+    }
+
+    void dump(PrintWriter writer) {
+        writer.println("  Onyx sensors: assist=" + mAssistSensor + ", pocket=" + mPocketSensor
+                + ", assistRegistered=" + mAssistRegistered + ", pocketRegistered="
+                + mPocketRegistered + ", touchMonitoring=" + (mInputMonitor != null));
+        mPolicy.dump(writer);
+    }
+}
