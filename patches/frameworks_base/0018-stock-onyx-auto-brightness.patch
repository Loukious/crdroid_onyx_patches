+        OnyxLuxPolicy.FastRateState state = new OnyxLuxPolicy.FastRateState();
+        state.ambientUpdated(0);
+        assertTrue(state.shouldUse(100, false, 100, 200));
+        assertTrue(state.shouldUse(200, false, 199, 250));
+        assertFalse(state.shouldUse(300, false, 200, 250));
+        assertFalse(state.shouldUse(400, false, 200, 250));
+    }
+
+    @Test
+    public void largeFastRate_requiresInitialOrPocketWindowAfterFirstAutoExpires() {
+        OnyxLuxPolicy.FastRateState state = expiredFirstAuto();
+        assertFalse(state.shouldUse(3001, mPolicy.inFastWindow(3001), 100, 200));
+        assertTrue(state.shouldUse(3000, mPolicy.inFastWindow(3000), 100, 200));
+        state = expiredFirstAuto();
+        mPolicy.pocketExited(10000);
+        assertTrue(state.shouldUse(12000, mPolicy.inFastWindow(12000), 100, 200));
+        state = expiredFirstAuto();
+        assertFalse(state.shouldUse(12001, mPolicy.inFastWindow(12001), 100, 200));
+    }
+
+    @Test
+    public void largeFastRate_latchesTargetForTwoSecondsAfterWindowCloses() {
+        OnyxLuxPolicy.FastRateState state = expiredFirstAuto();
+        assertTrue(state.shouldUse(3000, true, 100, 200));
+        assertTrue(state.shouldUse(4999, false, 190, 200));
+        assertFalse(state.shouldUse(5000, false, 190, 200));
+    }
+
+    @Test
+    public void lowerTarget_cancelsLargeFastRateLatch() {
+        OnyxLuxPolicy.FastRateState state = expiredFirstAuto();
+        assertTrue(state.shouldUse(3000, true, 100, 200));
+        assertFalse(state.shouldUse(3100, false, 150, 180));
+        assertFalse(state.shouldUse(3200, false, 150, 200));
+    }
+
+    @Test
+    public void higherTarget_cancelsLatchOnceCurrentHasReachedPreviousTarget() {
+        OnyxLuxPolicy.FastRateState state = expiredFirstAuto();
+        assertTrue(state.shouldUse(3000, true, 100, 200));
+        assertTrue(state.shouldUse(3100, false, 199, 250));
+        assertFalse(state.shouldUse(3200, false, 200, 250));
+        assertFalse(state.shouldUse(3300, false, 200, 250));
+    }
+
+    @Test
+    public void invalidNits_areRejectedEvenDuringFirstAutoAndZeroIsValid() {
+        OnyxLuxPolicy.FastRateState state = new OnyxLuxPolicy.FastRateState();
+        state.ambientUpdated(0);
+        assertFalse(state.shouldUse(100, true, Float.NaN, 100));
+        assertFalse(state.shouldUse(100, true, 100, Float.NaN));
+        assertFalse(state.shouldUse(100, true, Float.POSITIVE_INFINITY, 100));
+        assertFalse(state.shouldUse(100, true, 100, Float.NEGATIVE_INFINITY));
+        assertFalse(state.shouldUse(100, true, -1, 100));
+        assertFalse(state.shouldUse(100, true, 100, -1));
+        assertTrue(state.shouldUse(100, false, 0, 0));
+        state = expiredFirstAuto();
+        assertFalse(state.shouldUse(3000, true, 0, 55.49f));
+        assertTrue(state.shouldUse(3000, true, 0, 55.5f));
+    }
+
+    private static OnyxLuxPolicy.FastRateState expiredFirstAuto() {
+        OnyxLuxPolicy.FastRateState state = new OnyxLuxPolicy.FastRateState();
+        state.ambientUpdated(0);
+        return state;
+    }
+
+    private OnyxLuxPolicy newPolicy(int warmup) {
+        return new OnyxLuxPolicy(OnyxLuxPolicy.Thresholds.stock(4475),
+                (lux, fast, slow, fastChange) -> mUpdates.add(new Update(lux, fastChange)),
+                1500, 1000, warmup, 200, 1000, 1000, 5000, 3000, 2000, 1800);
+    }
+
+    private void main(long time, float lux) {
+        assertTrue(mPolicy.add(OnyxLuxPolicy.MAIN, time, lux, time));
+    }
+
+    private void assist(long time, float lux) {
+        assertTrue(mPolicy.add(OnyxLuxPolicy.ASSIST, time, lux, time));
+    }
+
+    private Update last() {
+        return mUpdates.get(mUpdates.size() - 1);
+    }
+
+    private static final class Update {
+        final float lux;
+        final boolean fastChange;
+
+        Update(float lux, boolean fastChange) {
+            this.lux = lux;
+            this.fastChange = fastChange;
+        }
+    }
+}
