+        private static Pair<float[], float[]> insertOnyxUserPoint(float[] lux, float[] brightness,
+                float userLux, float userBrightness, float unadjustedBrightness) {
+            int idx = 0;
+            while (idx < lux.length && lux[idx] < userLux) {
+                idx++;
+            }
+            float[] newLux;
+            float[] newBrightness;
+            if (idx < lux.length && lux[idx] == userLux) {
+                newLux = Arrays.copyOf(lux, lux.length);
+                newBrightness = Arrays.copyOf(brightness, brightness.length);
+            } else {
+                newLux = new float[lux.length + 1];
+                newBrightness = new float[brightness.length + 1];
+                System.arraycopy(lux, 0, newLux, 0, idx);
+                System.arraycopy(brightness, 0, newBrightness, 0, idx);
+                System.arraycopy(lux, idx, newLux, idx + 1, lux.length - idx);
+                System.arraycopy(brightness, idx, newBrightness, idx + 1,
+                        brightness.length - idx);
