+        assertFalse(state.shouldUse(0, false, 10, 11));
+        state.ambientUpdated(1000);
+        assertTrue(state.shouldUse(1000, false, 10, 11));
+        assertTrue(state.shouldUse(2999, false, 10, 11));
+        assertFalse(state.shouldUse(3000, false, 10, 11));
+        state.ambientUpdated(4000); // Ordinary ALS updates must not rearm first-auto behavior.
+        assertFalse(state.shouldUse(4000, false, 10, 11));
+        state.reset();
+        assertFalse(state.shouldUse(4000, false, 10, 11));
+        state.ambientUpdated(5000);
+        assertTrue(state.shouldUse(6999, false, 10, 11));
+        assertFalse(state.shouldUse(7000, false, 10, 11));
