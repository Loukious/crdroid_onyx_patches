+        // This exceeds the 60% ratio gate, but misses the 55.5-nit absolute increase.
+        assertFalse(state.shouldUse(3000, true, 10, 65.49f));
+        // This exceeds the absolute increase, but misses the 60% ratio gate.
+        assertFalse(state.shouldUse(3000, true, 100, 159.99f));
+        // 148 - 92.5 = 55.5, and 148 = 92.5 * 1.6: equality passes both stock gates.
+        assertTrue(state.shouldUse(3000, true, 92.5f, 148));
+    }
