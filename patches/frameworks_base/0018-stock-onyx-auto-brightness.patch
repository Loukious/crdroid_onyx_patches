+package com.android.server.display;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import android.util.Spline;
+
+import androidx.test.filters.SmallTest;
+
+import org.junit.Before;
+import org.junit.Test;
+
+@SmallTest
+public class OnyxBrightnessRampControllerTest {
+    private OnyxBrightnessRampController mController;
+
+    @Before
+    public void setUp() {
+        mController = makeController(1f);
+    }
+
+    private static OnyxBrightnessRampController makeController(float normalMaximum) {
+        return new OnyxBrightnessRampController(new OnyxBrightnessRampController.NitMapper() {
+            @Override
+            public float toNits(float brightness) {
+                return brightness * 1000f;
+            }
+
+            @Override
+            public float toBrightness(float nits) {
+                return nits / 1000f;
+            }
+        }, new float[]{0f, 0.5f, 1f}, new float[]{0f, 500f, 1000f}, normalMaximum);
+    }
+
+    @Test
+    public void stockPanelLinearNitsRoundTrip() {
+        float[] brightness = {0.000854597f, 0.499938957f, 0.666890490f, 1f};
+        float[] nits = {2f, 600f, 800f, 3200f};
+        Spline toNits = Spline.createLinearSpline(brightness, nits);
+        Spline toBrightness = Spline.createLinearSpline(nits, brightness);
+        for (float value : new float[]{2f, 3.5f, 35f, 87.450005f, 265f, 799f, 1500f, 3200f}) {
+            assertEquals(value, toNits.interpolate(toBrightness.interpolate(value)), 0.0005f);
+        }
+        mController = new OnyxBrightnessRampController(new OnyxBrightnessRampController.NitMapper() {
+            @Override
+            public float toNits(float value) {
+                return toNits.interpolate(value);
+            }
+
+            @Override
+            public float toBrightness(float value) {
+                return toBrightness.interpolate(value);
+            }
+        }, brightness, nits, 0.499938957f);
+        OnyxBrightnessRampController.State state = mController.newState();
+        float start = toBrightness.interpolate(3.5f);
+        state.setTarget(start, toBrightness.interpolate(500f), 0.24081309f, 0f);
+        float current = advanceFrames(state, start, 60, 0.8f);
+        assertEquals(35f, toNits.interpolate(current), 0.1f);
+        current = advanceFrames(state, current, 60, 1f);
+        assertEquals(87.450005f, toNits.interpolate(current), 2f);
+        current = advanceFrames(state, current, 60, 2.3f);
+        assertEquals(500f, toNits.interpolate(current), 0.0005f);
+    }
+
+    @Test
+    public void distinctFourteenBitStepsUseCustomRateAndEqualityUsesSafeguard() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.01f, 0.5f, 0.24081309f, 0f);
+        assertEquals((0.035f - 0.01f) / 0.8f, state.getRate(0.01f), 0.0000001f);
+        state.setTarget(0.5f, 0.500001f, 0.24081309f, 0f);
+        assertEquals(OnyxBrightnessRampController.SLOW_SAFEGUARD_RATE,
+                state.getRate(0.5f), 0f);
+        mController.setTransition(OnyxBrightnessRampController.MANUAL, false);
+        state.setTarget(0.5f, 0.500001f, 0.3010011f, 0f);
+        assertEquals(OnyxBrightnessRampController.FAST_SAFEGUARD_RATE,
+                state.getRate(0.5f), 0f);
+    }
+
+    @Test
+    public void below35NitsUsesStockNitDifferenceRate() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.01f, 0.03f, 0.2f, 0f);
+        assertEquals(0.005f, state.getRate(0.01f), 0.0000001f);
+    }
+
+    @Test
+    public void lowToHighAutoBrighteningPassesStockStages() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.01f, 0.5f, 0.24081309f, 0f);
+        float current = advanceFrames(state, 0.01f, 60, 0.8f);
+        assertEquals(0.035f, current, 0.00006f);
+        current = advanceFrames(state, current, 60, 1f);
+        assertEquals(0.087450005f, current, 0.002f);
+        current = advanceFrames(state, current, 60, 2.3f);
+        assertEquals(0.5f, current, 0f);
+    }
+
+    @Test
+    public void moderateTargetUses1800MillisLinearStage() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.01f, 0.15f, 0.2f, 0f);
+        assertEquals((0.035f - 0.01f) / 1.8f, state.getRate(0.01f), 0.0000001f);
+        assertEquals(0.035f, state.advance(0.01f, 1.8f), 0.00005f);
+        assertEquals(0.15f, advanceFrames(state, 0.01f, 60, 4.1f), 0f);
+    }
+
+    @Test
+    public void everyDarkeningBandUsesItsOwnExponentialCoefficient() {
+        float[] nits = {700f, 200f, 120f, 80f, 60f, 45f, 35f, 29f, 20f};
+        float[] b = {0.9887f, 0.992f, 0.995f, 0.9965f, 0.9973f,
+                0.9979f, 0.9982f, 0.999f, 0.996f};
+        for (int i = 0; i < nits.length; i++) {
+            assertEquals(i, OnyxBrightnessRampController.getNitBand(nits[i]));
+            OnyxBrightnessRampController.State state = mController.newState();
+            state.setTarget(nits[i] / 1000f, 0.005f, 0.2f, 0f);
+            assertEquals((float) (nits[i] * 24f * Math.abs(Math.log(b[i])) / 1000),
+                    state.getRate(nits[i] / 1000f), 0.000001f);
+        }
+    }
+
+    @Test
+    public void hbmDarkeningUsesStockIntegerSpan() {
+        mController = makeController(0.5f);
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.7f, 0.1f, 0.2f, 0f);
+        float hbmRange = (16383f - OnyxBrightnessRampController.brightnessToInt(0.5f) - 1)
+                / 16382f;
+        assertEquals((float) (hbmRange * 700f * 24f * Math.abs(Math.log(0.9887f)) / 500f),
+                state.getRate(0.7f), 0.000001f);
+    }
+
+    @Test
+    public void aboveFitAnchorUsesAbsoluteStockTimeCoordinate() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.9f, 0.1f, 0.2f, 0f);
+        assertEquals((float) (800f * 800f / 900f * 24 * Math.abs(Math.log(0.9887f))
+                / 1000), state.getRate(0.9f), 0.000001f);
+    }
+
+    @Test
+    public void manualDimHdrAndDozeUseStockDurationsAndEquations() {
+        int[] modes = {OnyxBrightnessRampController.MANUAL, OnyxBrightnessRampController.DIM,
+                OnyxBrightnessRampController.TEMPORARY, OnyxBrightnessRampController.HDR,
+                OnyxBrightnessRampController.DOZE_TO_ON, OnyxBrightnessRampController.DOZE};
+        float[] seconds = {0.8f, 1.2f, 0.5f, 4f, 0.35f, 0.45f};
+        for (int i = 0; i < modes.length; i++) {
+            mController.setTransition(modes[i], false);
+            OnyxBrightnessRampController.State state = mController.newState();
+            state.setTarget(0.2f, 0.8f, 0.3f, 0f);
+            assertEquals((float) ((Math.exp(0.8f) - Math.exp(0.2f))
+                    / seconds[i] / Math.exp(0.2f)), state.getRate(0.2f), 0.000001f);
+            assertEquals(0.8f, advanceFrames(state, 0.2f, 60, seconds[i] + 0.1f), 0f);
+        }
+        assertEquals(0.8f, OnyxBrightnessRampController.getDurationSeconds(
+                OnyxBrightnessRampController.DOZE_TO_ON, false), 0f);
+    }
+
+    @Test
+    public void thermalRateTracksTenNitsPerSecond() {
+        mController.setTransition(OnyxBrightnessRampController.THERMAL, true);
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.7f, 0.2f, 0.2f, 0f);
+        assertEquals(0.01f, state.getRate(0.7f), 0.0000001f);
+        assertEquals(0.69f, state.advance(0.7f, 1f), 0.0000001f);
+    }
+
+    @Test
+    public void eachRefreshRateUsesTheStockPerFrameEulerSequence() {
+        float coefficient = (float) (Math.log(2f) / 4f);
+        for (int fps : new int[]{30, 60, 120}) {
+            OnyxBrightnessRampController.State state = mController.newState();
+            state.setTarget(0.1f, 0.2f, 0.2f, 0f);
+            // In this single exponential segment the stock recurrence has a closed form.
+            float expected = 0.1f * (float) Math.pow(1d + coefficient / fps, 2 * fps);
+            assertEquals(expected, advanceFrames(state, 0.1f, fps, 2f), 0.000001f);
+        }
+    }
+
+    @Test
+    public void skippedFrameUsesOneStockEulerStepRatherThanSubdividingTheDelta() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.1f, 0.2f, 0.2f, 0f);
+        float expected = 0.1f + (float) (2f * Math.log(2f) / 4f * 0.1f);
+        assertEquals(expected, state.advance(0.1f, 2f), 0.0000001f);
+    }
+
+    private static float advanceFrames(OnyxBrightnessRampController.State state, float current,
+            int framesPerSecond, float seconds) {
+        for (int i = 0; i < Math.round(framesPerSecond * seconds); i++) {
+            current = state.advance(current, 1f / framesPerSecond);
+        }
+        return current;
+    }
+
+    @Test
+    public void maximumDurationSurvivesPerFrameRateRecalculation() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.01f, 0.5f, 0.2f, 0.4f);
+        assertEquals(0.5f, state.advance(0.01f, 0.4f), 0f);
+    }
+
+    @Test
+    public void retargetRebasesWithoutJumpAndUnchangedTargetDoesNotRestart() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.01f, 0.5f, 0.2f, 0f);
+        float current = state.advance(0.01f, 1f);
+        float rate = state.getRate(current);
+        state.setTarget(current, 0.5f, 0.2f, 0f);
+        assertEquals(rate, state.getRate(current), 0f);
+        state.setTarget(current, 0.02f, 0.2f, 0f);
+        float next = state.advance(current, 0.016f);
+        assertTrue(next < current);
+        assertTrue(next > 0.02f);
+    }
+
+    @Test
+    public void minimumRatePreventsVerySmallDarkeningFromStalling() {
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.0005f, 0.0001f, 0.2f, 0f);
+        assertEquals(OnyxBrightnessRampController.MINIMUM_RATE, state.getRate(0.0005f), 0f);
+    }
+
+    @Test
+    public void changingAdjustedNitMappingIsUsedDuringAnOngoingRamp() {
+        float[] nitScale = {1000f};
+        mController = new OnyxBrightnessRampController(new OnyxBrightnessRampController.NitMapper() {
+            @Override
+            public float toNits(float brightness) {
+                return brightness * nitScale[0];
+            }
+
+            @Override
+            public float toBrightness(float nits) {
+                return nits / nitScale[0];
+            }
+        }, new float[]{0f, 1f}, new float[]{0f, 1000f}, 1f);
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.01f, 0.5f, 0.2f, 0f);
+        float current = state.advance(0.01f, 0.8f);
+        nitScale[0] = 500f;
+        assertEquals((0.07f - 0.01f) / 1.8f, state.getRate(current), 0.0000001f);
+        assertTrue(state.advance(current, 0.01f) > current);
+    }
+
+    @Test
+    public void durationBasedHdrDoesNotApplyAutomaticMinimumRateToSmallDistinctDbvChange() {
+        mController.setTransition(OnyxBrightnessRampController.HDR, false);
+        OnyxBrightnessRampController.State state = mController.newState();
+        state.setTarget(0.4f, 0.4001f, 0.3f, 0f);
+        float coefficient = (((float) Math.exp(0.4001f) - (float) Math.exp(0.4f)) * 1000f)
+                / 4000f;
+        float expected = coefficient / (float) Math.exp(0.4f);
+        assertEquals(expected, state.getRate(0.4f), 0f);
+        assertTrue(expected < OnyxBrightnessRampController.MINIMUM_RATE);
+    }
+}
