+package com.android.server.display;
+
+import java.io.PrintWriter;
+import java.util.ArrayList;
+
+/**
+ * Onyx's two independent ALS histories, absolute hysteresis and selection policy.
+ *
+ * <p>Times, including protection deadlines, are milliseconds on one monotonic sensor clock.
+ * This class has no Android dependencies so recorded light traces can exercise the policy.
+ * The equations and anchors are from the shipped Onyx 303/305 display services and resources.
+ */
+final class OnyxLuxPolicy {
+    static final int MAIN = 0;
+    static final int ASSIST = 1;
+    static final int NONE = -1;
+    private static final long HISTORY_MILLIS = 5000;
+
+    interface Listener {
+        void onAmbientLux(float lux, float fastLux, float slowLux, boolean fastChange);
+    }
+
+    /** The adapter uses this only for an on-change sensor's initial cached observation. */
+    static final class SampleTime {
+        static final long INVALID = Long.MIN_VALUE;
+        private long mRegistrationTime;
+        private boolean mInitialOnChange;
+
+        void registered(long time, boolean onChange) {
+            mRegistrationTime = time;
+            mInitialOnChange = onChange;
+        }
+
+        void clear() {
+            mInitialOnChange = false;
+        }
+
+        long normalize(long time, float lux, long now) {
+            if (!Float.isFinite(lux) || lux < 0 || time < 0 || time > now) return INVALID;
+            if (mInitialOnChange) {
+                mInitialOnChange = false;
+                // SensorService sends the current cached value when an on-change sensor is
+                // registered. Its hardware timestamp can predate registration by minutes if
+                // the light has not changed. It is an initial observation, not queued history.
+                if (time < mRegistrationTime) return now;
+            }
+            return time;
+        }
+    }
+
+    /** Stock first-auto latch and the two nits gates for later fast changes. */
+    static final class FastRateState {
+        private boolean mFirst = true;
+        private long mFirstUntil = Long.MIN_VALUE;
+        private float mFirstTarget = Float.NaN;
+        private long mFastUntil = Long.MIN_VALUE;
+        private float mFastTarget = Float.NaN;
+
+        void reset() {
+            reset(true);
+        }
+
+        void reset(boolean firstAutoBrightness) {
+            mFirst = firstAutoBrightness;
+            mFirstUntil = Long.MIN_VALUE;
+            mFirstTarget = Float.NaN;
+            mFastUntil = Long.MIN_VALUE;
+            mFastTarget = Float.NaN;
+        }
+
+        void ambientUpdated(long now) {
+            if (mFirst) {
+                mFirst = false;
+                mFirstUntil = now + 2000;
+            }
+        }
+
+        boolean shouldUse(long now, boolean fastWindow, float currentNits, float targetNits) {
+            if (!Float.isFinite(currentNits) || !Float.isFinite(targetNits)
+                    || currentNits < 0 || targetNits < 0) return false;
+            if (now < mFirstUntil) {
+                if (!Float.isFinite(mFirstTarget)) mFirstTarget = targetNits;
+                if (targetNits < mFirstTarget
+                        || targetNits > mFirstTarget && currentNits >= mFirstTarget) {
+                    mFirstUntil = Long.MIN_VALUE;
+                } else {
+                    return true;
+                }
+            }
+            if (now < mFastUntil && Float.isFinite(mFastTarget)) {
+                if (targetNits < mFastTarget
+                        || targetNits > mFastTarget && currentNits >= mFastTarget) {
+                    mFastTarget = Float.NaN;
+                    mFastUntil = Long.MIN_VALUE;
+                } else {
+                    return true;
+                }
+            }
+            if (fastWindow && targetNits >= currentNits + 55.5f
+                    && targetNits >= currentNits * 1.6f) {
+                mFastTarget = targetNits;
+                mFastUntil = now + 2000;
+                return true;
+            }
+            return false;
+        }
+    }
+
+    static final class Thresholds {
+        static final float[] STOCK_BRIGHT_LUX = {0, 3, 4, 6, 7, 8, 9, 15, 30, 600,
+                1677.4f, 2000, 2500, 3000, 8500};
+        static final float[] STOCK_BRIGHT = {2, 6, 8.51f, 13.66f, 14.84f, 15.46f, 17.22f,
+                28.44f, 160, 992.58f, 3000, 4038.77f, 5738.77f, 7538.77f, 13038.8f};
+        static final float[] STOCK_DARK_LUX = {0, 1, 7, 8, 9, 10, 11, 12, 13, 14, 15, 30,
+                199, 200, 360, 600, 1010.47f, 3000, 20000};
+        static final float[] STOCK_DARK = {0, .32f, 3.53f, 3.8f, 4.1f, 4.45f, 4.82f, 5.2f,
+                5.58f, 6.05f, 6.9f, 15.83f, 34.31f, 41.39f, 45.34f, 216.99f, 600,
+                2052.56f, 10012};
+        private final float[] mBrightLux;
+        private final float[] mBright;
+        private final float[] mSmallBright;
+        private final float[] mDarkLux;
+        private final float[] mDark;
+        private final float mHbmMinimumLux;
+
+        Thresholds(float[] brightLux, float[] bright, float[] darkLux, float[] dark,
+                float smallRatio, float hbmMinimumLux) {
+            validate(brightLux, bright);
+            validate(darkLux, dark);
+            if (!Float.isFinite(smallRatio) || smallRatio < 0 || smallRatio > 1
+                    || !Float.isFinite(hbmMinimumLux) || hbmMinimumLux < 0) {
+                throw new IllegalArgumentException("Invalid Onyx hysteresis configuration");
+            }
+            mBrightLux = brightLux.clone();
+            mBright = bright.clone();
+            mDarkLux = darkLux.clone();
+            mDark = dark.clone();
+            mHbmMinimumLux = hbmMinimumLux;
+            mSmallBright = new float[bright.length];
+            for (int i = 0; i < bright.length; i++) {
+                mSmallBright[i] = brightLux[i] <= 10 ? bright[i]
+                        : Math.max(bright[i] * smallRatio + brightLux[i] * (1 - smallRatio),
+                                i == 0 ? bright[i] : bright[i - 1]);
+            }
+        }
+
+        static Thresholds stock(float hbmMinimumLux) {
+            return new Thresholds(STOCK_BRIGHT_LUX, STOCK_BRIGHT, STOCK_DARK_LUX, STOCK_DARK,
+                    .6f, hbmMinimumLux);
+        }
+
+        float bright(float lux) {
+            return lux > mHbmMinimumLux ? lux + 1 : interpolate(mBrightLux, mBright, lux);
+        }
+
+        float smallBright(float lux) {
+            return lux > mHbmMinimumLux ? lux + 1 : interpolate(mBrightLux, mSmallBright, lux);
+        }
+
+        float dark(float lux) {
+            return interpolate(mDarkLux, mDark, lux);
+        }
+
+        private static void validate(float[] x, float[] y) {
+            if (x == null || y == null || x.length < 2 || x.length != y.length) {
+                throw new IllegalArgumentException("Mismatched Onyx hysteresis arrays");
+            }
+            for (int i = 0; i < x.length; i++) {
+                if (!Float.isFinite(x[i]) || !Float.isFinite(y[i]) || x[i] < 0 || y[i] < 0
+                        || (i > 0 && x[i] <= x[i - 1])) {
+                    throw new IllegalArgumentException("Invalid Onyx hysteresis anchor");
+                }
+            }
+        }
+
+        private static float interpolate(float[] x, float[] y, float value) {
+            if (value <= x[0]) return y[0];
+            for (int i = 1; i < x.length; i++) {
+                if (value <= x[i]) {
+                    float t = (value - x[i - 1]) / (x[i] - x[i - 1]);
+                    return y[i - 1] + t * (y[i] - y[i - 1]);
+                }
+            }
+            return y[y.length - 1];
+        }
+    }
+
+    /** Time-weighted integration, with the same 100ms prediction as stock. */
+    static final class History {
+        private final ArrayList<Sample> mSamples = new ArrayList<>();
+        private final int mLongHorizon;
+        private long mLastTime = Long.MIN_VALUE;
+
+        History(int longHorizon) {
+            mLongHorizon = longHorizon;
+        }
+
+        boolean push(long time, float lux) {
+            if (!Float.isFinite(lux) || lux < 0 || time < mLastTime) return false;
+            prune(time);
+            mSamples.add(new Sample(time, lux));
+            mLastTime = time;
+            return true;
+        }
+
+        void prune(long now) {
+            long cutoff = now - HISTORY_MILLIS;
+            while (mSamples.size() > 1 && mSamples.get(1).time <= cutoff) {
+                mSamples.remove(0);
+            }
+            if (!mSamples.isEmpty() && mSamples.get(0).time < cutoff) {
+                mSamples.get(0).time = cutoff;
+            }
+        }
+
+        boolean hasReading() {
+            return !mSamples.isEmpty();
+        }
+
+        float lux(long now, int horizon) {
+            if (mSamples.isEmpty()) return -1;
+            int first = 0;
+            long cutoff = now - horizon;
+            while (first + 1 < mSamples.size() && mSamples.get(first + 1).time <= cutoff) first++;
+            float sum = 0;
+            float total = 0;
+            long end = 100;
+            for (int i = mSamples.size() - 1; i >= first; i--) {
+                Sample sample = mSamples.get(i);
+                long start = Math.max(sample.time, cutoff) - now;
+                float weight = integral(end) - integral(start);
+                sum += sample.lux * weight;
+                total += weight;
+                end = start;
+            }
+            return total > 0 ? sum / total : mSamples.get(mSamples.size() - 1).lux;
+        }
+
+        long transition(long now, float threshold, long debounce, boolean brighten) {
+            long earliest = now;
+            for (int i = mSamples.size() - 1; i >= 0; i--) {
+                Sample sample = mSamples.get(i);
+                if (brighten ? sample.lux <= threshold : sample.lux >= threshold) break;
+                earliest = sample.time;
+            }
+            return earliest + debounce;
+        }
+
+        void clear() {
+            mSamples.clear();
+            mLastTime = Long.MIN_VALUE;
+        }
+
+        private float integral(long time) {
+            return time * (time * .5f + mLongHorizon);
+        }
+
+        private static final class Sample {
+            long time;
+            float lux;
+            Sample(long time, float lux) {
+                this.time = time;
+                this.lux = lux;
+            }
+        }
+    }
+
+    private final History[] mHistories;
+    private final float[] mFast = {-1, -1};
+    private final float[] mSlow = {-1, -1};
+    private final float[] mBright = {-1, -1};
+    private final float[] mSmallBright = {-1, -1};
+    private final float[] mDark = {-1, -1};
+    private final boolean[] mValid = {false, false};
+    private final Thresholds mThresholds;
+    private final Listener mListener;
+    private final int mLongHorizon;
+    private final int mShortHorizon;
+    private final int mWarmUp;
+    private final int mRate;
+    private final long mBrightDebounce;
+    private final long mDarkDebounce;
+    private final long mSmallDebounce;
+    private final long mInitialFastWindow;
+    private final long mPocketFastWindow;
+    private final long mTorchCooldown;
+    private long mEnableTime;
+    private long mPocketExit = Long.MIN_VALUE;
+    private long mTorchOff = Long.MIN_VALUE;
+    private long mTouchUntil = Long.MIN_VALUE;
+    private boolean mTorch;
+    private boolean mTouch;
+    private boolean mEnabled;
+    private int mSource = NONE;
+    private float mAmbientLux = -1;
+
+    OnyxLuxPolicy(Thresholds thresholds, Listener listener, int longHorizon, int shortHorizon,
+            int warmUp, int rate, long brightDebounce, long darkDebounce, long smallDebounce,
+            long initialFastWindow, long pocketFastWindow, long torchCooldown) {
+        if (shortHorizon <= 0 || longHorizon < shortHorizon || longHorizon > HISTORY_MILLIS
+                || rate <= 0 || warmUp < 0 || brightDebounce < 0 || darkDebounce < 0
+                || smallDebounce < 0 || smallDebounce > HISTORY_MILLIS) {
+            throw new IllegalArgumentException("Invalid Onyx sensor timing");
+        }
+        mThresholds = thresholds;
+        mListener = listener;
+        mLongHorizon = longHorizon;
+        mShortHorizon = shortHorizon;
+        mWarmUp = warmUp;
+        mRate = rate;
+        mBrightDebounce = brightDebounce;
+        mDarkDebounce = darkDebounce;
+        mSmallDebounce = smallDebounce;
+        mInitialFastWindow = initialFastWindow;
+        mPocketFastWindow = pocketFastWindow;
+        mTorchCooldown = torchCooldown;
+        mHistories = new History[] {new History(longHorizon), new History(longHorizon)};
+    }
+
+    void setEnabled(boolean enabled, long now) {
+        if (mEnabled == enabled) return;
+        mEnabled = enabled;
+        mEnableTime = now;
+        mSource = NONE;
+        mAmbientLux = -1;
+        mPocketExit = Long.MIN_VALUE;
+        mTouchUntil = Long.MIN_VALUE;
+        mTouch = false;
+        for (int i = MAIN; i <= ASSIST; i++) {
+            invalidate(i);
+        }
+    }
+
+    boolean add(int sensor, long time, float lux, long now) {
+        if (!mEnabled || time < mEnableTime || time > now || now - time > HISTORY_MILLIS
+                || (sensor == MAIN && mAmbientLux >= 0 && covered(now))
+                || (sensor == ASSIST && !assistAllowed(now))) return false;
+        if (!mHistories[sensor].push(time, lux)) return false;
+        if (sensor == MAIN && mAmbientLux >= 0 && inFastWindow(now)
+                && lux >= mThresholds.bright(mAmbientLux) && lux >= mAmbientLux + 20
+                && lux >= mAmbientLux * 1.6f
+                && (mSource != ASSIST || lux >= mFast[ASSIST])) {
+            mFast[MAIN] = lux;
+            mSlow[MAIN] = lux;
+            mValid[MAIN] = true;
+            setThresholds(MAIN, lux);
+            select(MAIN, true);
+        } else {
+            update(now, sensor);
+        }
+        return true;
+    }
+
+    /** Returns the next required update on the sensor clock. */
+    long update(long now) {
+        return update(now, NONE);
+    }
+
+    private long update(long now, int event) {
+        if (!mEnabled) return Long.MAX_VALUE;
+        long next = Long.MAX_VALUE;
+        for (int sensor = MAIN; sensor <= ASSIST; sensor++) {
+            if (!mHistories[sensor].hasReading()
+                    || sensor == ASSIST && !assistAllowed(now)) continue;
+            mHistories[sensor].prune(now);
+            if (now < mEnableTime + mWarmUp) {
+                next = Math.min(next, mEnableTime + mWarmUp);
+                continue;
+            }
+            mFast[sensor] = mHistories[sensor].lux(now, mShortHorizon);
+            mSlow[sensor] = mHistories[sensor].lux(now, mLongHorizon);
+            if (!mValid[sensor]) {
+                mValid[sensor] = true;
+                setThresholds(sensor, mFast[sensor]);
+                if (mSource == NONE || (sensor == MAIN && mFast[MAIN] >= mFast[ASSIST])
+                        || (sensor == ASSIST && mFast[ASSIST] > mBright[MAIN])) {
+                    select(sensor, mSource == NONE);
+                }
+            }
+        }
+        for (int sensor = MAIN; sensor <= ASSIST; sensor++) {
+            if (!mValid[sensor] || sensor == ASSIST && !assistAllowed(now)) continue;
+            float bright = mFast[sensor] < mBright[sensor]
+                    ? mSmallBright[sensor] : mBright[sensor];
+            long brighten = mHistories[sensor].transition(now, bright,
+                    mFast[sensor] < mBright[sensor] ? mSmallDebounce : mBrightDebounce, true);
+            long darken = mHistories[sensor].transition(now, mDark[sensor], mDarkDebounce, false);
+            boolean rising = mFast[sensor] >= bright && mSlow[sensor] >= bright && brighten <= now;
+            boolean falling = mFast[sensor] <= mDark[sensor] && darken <= now;
+            // Sensor event provenance matters: the inactive history should not drive transitions
+            // until its own update/deadline, matching the stock two policy handlers.
+            if ((event == NONE || event == sensor) && (rising || falling)) {
+                if (sensor == MAIN) {
+                    if (mSource == MAIN && rising || !mValid[ASSIST]
+                            || mFast[MAIN] >= mFast[ASSIST]) {
+                        select(MAIN, false);
+                    } else if (mSource == MAIN && falling) {
+                        setThresholds(ASSIST, mFast[ASSIST]);
+                        select(ASSIST, false);
+                    }
+                    setThresholds(MAIN, mFast[MAIN]);
+                } else {
+                    if (mSource == MAIN && mSlow[ASSIST] > mBright[MAIN]
+                            && mFast[ASSIST] > mBright[MAIN]
+                            || mSource == ASSIST && mFast[ASSIST] > mFast[MAIN]) {
+                        select(ASSIST, false);
+                    } else if (mSource == ASSIST && mValid[MAIN]) {
+                        setThresholds(MAIN, mFast[MAIN]);
+                        select(MAIN, false);
+                    }
+                    setThresholds(ASSIST, mFast[ASSIST]);
+                }
+                brighten = mHistories[sensor].transition(now, mBright[sensor], mBrightDebounce, true);
+                darken = mHistories[sensor].transition(now, mDark[sensor], mDarkDebounce, false);
+            }
+            long deadline = Math.min(brighten, darken);
+            next = Math.min(next, deadline > now ? deadline : now + mRate);
+        }
+        return next;
+    }
+
+    void setTorch(boolean torch, long now) {
+        if (mTorch == torch) return;
+        mTorch = torch;
+        if (!torch) mTorchOff = now;
+    }
+
+    void setTouch(boolean touching, long now, long debounce) {
+        mTouch = touching;
+        if (touching) mTouchUntil = now + debounce;
+    }
+
+    void pocketExited(long now) {
+        if (mEnabled) mPocketExit = now;
+    }
+
+    boolean inFastWindow(long now) {
+        return mEnabled && (now <= mEnableTime + mInitialFastWindow
+                || mPocketExit != Long.MIN_VALUE && now <= mPocketExit + mPocketFastWindow);
+    }
+
+    private boolean assistAllowed(long now) {
+        return !mTorch && (mTorchOff == Long.MIN_VALUE || now - mTorchOff > mTorchCooldown);
+    }
+
+    private boolean covered(long now) {
+        return mTouch || now < mTouchUntil;
+    }
+
+    private void invalidate(int sensor) {
+        mHistories[sensor].clear();
+        mValid[sensor] = false;
+        mFast[sensor] = -1;
+        mSlow[sensor] = -1;
+    }
+
+    private void setThresholds(int sensor, float lux) {
+        mBright[sensor] = mThresholds.bright(lux);
+        mSmallBright[sensor] = mThresholds.smallBright(lux);
+        mDark[sensor] = mThresholds.dark(lux);
+    }
+
+    private void select(int sensor, boolean fastChange) {
+        mSource = sensor;
+        if (mAmbientLux != mFast[sensor]) {
+            mAmbientLux = mFast[sensor];
+            mListener.onAmbientLux(mAmbientLux, mFast[sensor], mSlow[sensor], fastChange);
+        }
+    }
+
+    float brighteningThreshold(float lux) { return mThresholds.bright(lux); }
+    float darkeningThreshold(float lux) { return mThresholds.dark(lux); }
+    int source() { return mSource; }
+    float ambientLux() { return mAmbientLux; }
+
+    void dump(PrintWriter writer) {
+        writer.println("  OnyxLuxPolicy: enabled=" + mEnabled + ", source=" + mSource
+                + ", ambientLux=" + mAmbientLux + ", mainFast=" + mFast[MAIN]
+                + ", mainSlow=" + mSlow[MAIN] + ", assistFast=" + mFast[ASSIST]
+                + ", assistSlow=" + mSlow[ASSIST] + ", torch=" + mTorch
+                + ", touch=" + mTouch + ", torchOff=" + mTorchOff);
+    }
+}
diff --git a/services/core/java/com/android/server/display/RampAnimator.java b/services/core/java/com/android/server/display/RampAnimator.java
index 01ca06dcd3b99..31c36a8e05720 100644
--- a/services/core/java/com/android/server/display/RampAnimator.java
+++ b/services/core/java/com/android/server/display/RampAnimator.java
@@ -69,6 +69,14 @@ class RampAnimator<T> {
 
     private boolean mFirstTime = true;
 
+    @Nullable
+    private OnyxBrightnessRampController.State mOnyxState;
+    @Nullable
+    private OnyxBrightnessRampController mOnyxController;
+    private float mOnyxAnimatedLinearValue;
+    private boolean mUseNativeRate;
+    private boolean mRebaseNativeBrightness;
+
     RampAnimator(T object, FloatProperty<T> property) {
         this(object, property, System::nanoTime);
     }
@@ -101,6 +109,28 @@ class RampAnimator<T> {
         mDarkeningRampGamma = darkeningRampGamma;
     }
 
+    /** Enables the opt-in Onyx equations without changing the ordinary HLG animator. */
+    void setOnyxBrightnessRampController(@Nullable OnyxBrightnessRampController controller) {
+        if (mOnyxController == controller) {
+            return;
+        }
+        mOnyxController = controller;
+        mUseNativeRate = false;
+        mOnyxState = controller == null ? null : controller.newState();
+        if (!mFirstTime) {
+            // Preserve the displayed value when a display/configuration is replaced mid-ramp.
+            float linear = mProperty.get(mObject);
+            mCurrentRampGamma = 1f;
+            mCurrentValue = BrightnessUtils.convertLinearToGamma(linear);
+            mAnimatedValue = mCurrentValue;
+            mOnyxAnimatedLinearValue = linear;
+            mTargetHlgValue = BrightnessUtils.convertLinearToGamma(mTargetLinearValue);
+            if (mOnyxState != null) {
+                mOnyxState.setTarget(linear, mTargetLinearValue, mRate, 0);
+            }
+        }
+    }
