+    @VisibleForTesting
+    static int getOnyxBrightnessRampMode(BrightnessReason reason, int state, boolean wasDozing,
+            boolean wasDimmed, boolean temporary, boolean hdr, boolean fastAuto) {
+        final int modifiers = reason.getModifier();
+        if (wasDimmed || (modifiers & BrightnessReason.MODIFIER_DIMMED) != 0) {
+            return OnyxBrightnessRampController.DIM;
+        }
+        if (Display.isDozeState(state)
+                || reason.getReason() == BrightnessReason.REASON_DOZE
+                || reason.getReason() == BrightnessReason.REASON_DOZE_DEFAULT
+                || reason.getReason() == BrightnessReason.REASON_DOZE_MANUAL) {
+            return OnyxBrightnessRampController.DOZE;
+        }
+        if (state == Display.STATE_ON && wasDozing && !hdr
+                && (modifiers & BrightnessReason.MODIFIER_HDR) == 0) {
+            return OnyxBrightnessRampController.DOZE_TO_ON;
+        }
+        if (temporary) {
+            return OnyxBrightnessRampController.TEMPORARY;
+        }
+        if (reason.getReason() == BrightnessReason.REASON_OVERRIDE) {
+            return OnyxBrightnessRampController.MANUAL;
+        }
+        if (hdr || (modifiers & BrightnessReason.MODIFIER_HDR) != 0) {
+            return OnyxBrightnessRampController.HDR;
+        }
+        if ((modifiers & BrightnessReason.MODIFIER_THROTTLED) != 0) {
+            return OnyxBrightnessRampController.THERMAL;
+        }
+        if (reason.getReason() == BrightnessReason.REASON_AUTOMATIC && !fastAuto) {
+            return OnyxBrightnessRampController.AUTO;
+        }
+        return OnyxBrightnessRampController.MANUAL;
+    }
