+    State newState() {
+        return new State();
+    }
+
+    /** SDR and HDR animators each retain their own start, target, and limit. */
+    final class State {
+        private float mStart;
+        private float mTarget = Float.NaN;
+        private float mFallbackRate;
+        private float mLimitRate;
+        private int mVersion = -1;
+
+        void setTarget(float current, float target, float fallbackRate, float maxTimeSeconds) {
+            if (target != mTarget || mVersion != mTransitionVersion) {
+                mStart = current;
+                mTarget = target;
+                mVersion = mTransitionVersion;
+                mLimitRate = maxTimeSeconds > 0 ? Math.abs(target - current) / maxTimeSeconds : 0;
+            } else if (maxTimeSeconds > 0) {
+                // A faster request may tighten the bound without extending an existing ramp.
+                mLimitRate = Math.max(mLimitRate, Math.abs(target - current) / maxTimeSeconds);
+            }
+            mFallbackRate = fallbackRate;
+        }
+
+        @VisibleForTesting
+        float getRate(float current) {
+            // The low-level stock decompilation confirms this is the equality branch only.
+            // Distinct integers proceed to the custom equations, even for a tiny float delta.
+            if (mFallbackRate > 0 && brightnessToInt(current) == brightnessToInt(mTarget)) {
+                return Math.max(mLimitRate,
+                        mSlowChange ? SLOW_SAFEGUARD_RATE : FAST_SAFEGUARD_RATE);
+            }
+            float rate;
+            if (mTarget <= 0 || mFallbackRate <= 0) {
+                rate = mFallbackRate;
+            } else if (mMode == THERMAL) {
+                rate = getThermalRate(current);
+            } else if (mMode == AUTO) {
+                rate = mTarget > mStart ? getAutoBrighteningRate(current, mStart, mTarget)
+                        : getAutoDarkeningRate(current);
+            } else {
+                float durationMillis = getDurationSeconds(mMode, mTarget > mStart) * 1000f;
+                if (mTarget > mStart) {
+                    // Stock brightening log curve: dB/dt = (exp(target)-exp(start))/T/exp(B).
+                    float coefficient = (((float) Math.exp(mTarget) - (float) Math.exp(mStart))
+                            * 1000f) / durationMillis;
+                    rate = coefficient / (float) Math.exp(current);
+                } else {
+                    // Stock darkening exponential curve: dB/dt = abs(log(target/start)/T)*B.
+                    float coefficient = ((float) Math.log(mTarget / mStart) * 1000f)
+                            / durationMillis;
+                    rate = Math.abs(coefficient * current);
+                }
+            }
+            if (!isPositiveFinite(rate)) {
+                rate = mFallbackRate;
+            }
+            // Shipped minimum-rate floors belong to automatic brightening/darkening only;
+            // duration-based manual/HDR/doze curves must retain smaller rates for small deltas.
+            if (mMode == AUTO && rate > 0) {
+                rate = Math.max(MINIMUM_RATE, rate);
+            }
+            return Math.max(mLimitRate, rate);
+        }
+
+        float advance(float current, float elapsedSeconds) {
+            return advance(current, elapsedSeconds, 1f);
+        }
+
+        float advance(float current, float elapsedSeconds, float durationScale) {
+            if (current == mTarget || elapsedSeconds <= 0) {
+                return current;
+            }
+            // Shipped RampAnimator samples the custom rate at the start of each VSYNC and
+            // advances once by rate * delta / durationScale. Preserve that Euler arithmetic,
+            // including its refresh-rate dependence and behavior after a skipped frame.
+            float amount = (getRate(current) * elapsedSeconds) / durationScale;
+            float result = clamp(mTarget > current ? current + amount : current - amount);
+            // A rounding residue must not extend a configured hard maximum by another VSYNC.
+            return Math.abs(result - mTarget) <= Math.ulp(mTarget) * 2 ? mTarget : result;
+        }
+
+        private float clamp(float value) {
+            return mTarget > mStart ? Math.min(mTarget, Math.max(mStart, value))
+                    : Math.max(mTarget, Math.min(mStart, value));
+        }
+    }
+
+    private float getAutoBrighteningRate(float current, float start, float target) {
+        float nits = mMapper.toNits(current);
+        float startNits = mMapper.toNits(start);
+        float targetNits = mMapper.toNits(target);
+        if (!isPositiveFinite(nits) || !isPositiveFinite(startNits)
+                || !isPositiveFinite(targetNits)) {
+            return Float.NaN;
+        }
+        if (startNits < 35f) {
+            if (targetNits < 35f) {
+                // This stock branch converts the nit difference itself, not two endpoints.
+                return mMapper.toBrightness(targetNits - startNits) / 4f;
+            }
+            if (targetNits < 265f) {
+                return nits < 35f ? (mMapper.toBrightness(35f) - start) / 1.8f
+                        : getExponentialRate(35f, targetNits, current, 2.2f);
+            }
+            if (nits < 35f) {
+                return (mMapper.toBrightness(35f) - start) / 0.8f;
+            }
+            return nits < 87.450005f
+                    ? getExponentialRate(35f, 87.450005f, current, 1f)
+                    : getExponentialRate(87.450005f, targetNits, current, 2.2f);
+        }
+        if (startNits >= 265f || targetNits < 265f) {
+            return getExponentialRate(startNits, targetNits, current, 4f);
+        }
+        return nits < 87.450005f
+                ? getExponentialRate(startNits, 87.450005f, current, 1.8f)
+                : getExponentialRate(87.450005f, targetNits, current, 2.2f);
+    }
+
+    private float getExponentialRate(float startNits, float targetNits, float current,
+            float durationSeconds) {
+        float start = mMapper.toBrightness(startNits);
+        float target = mMapper.toBrightness(targetNits);
+        // Converting current nits back to brightness is intentional in the shipped equation.
+        float brightness = mMapper.toBrightness(mMapper.toNits(current));
+        float coefficient = (float) Math.log(target / start) / durationSeconds;
+        return coefficient * brightness;
+    }
+
+    private float getAutoDarkeningRate(float current) {
+        float nits = mMapper.toNits(current);
+        if (!isPositiveFinite(nits)) {
+            return Float.NaN;
+        }
+        int index = getNitBand(nits);
+        float a = A_LEVELS[index];
+        float b = B_LEVELS[index];
+        float time = Math.abs(((float) Math.log(nits / a) / (float) Math.log(b)) / 24f);
+        float nitRate = Math.abs(a * 24f * (float) Math.pow(b, time * 24f)
+                * (float) Math.log(b));
+        float normalNits = mMapper.toNits(mNormalMaximumBrightness);
+        if (!isPositiveFinite(normalNits)) {
+            normalNits = 500f;
+        }
+        // Onyx's stock config_max_hbm_brightness_for_peak and
+        // config_clamped_hdr_brightness_for_opr_optimize are both 1.0.
+        float maxNits = mMapper.toNits(1f);
+        if (nits > normalNits && maxNits > normalNits) {
+            // Stock normalizes the *integer difference*; subtracting floats loses one DBV step.
+            float hbmRange = brightnessIntToFloat(BRIGHTNESS_MAX_INT
+                    - brightnessToInt(mNormalMaximumBrightness));
+            return hbmRange * nitRate / (maxNits - normalNits);
+        }
+        // Stock Onyx config_supdark_brt_available is false, so there is no sub-3.5 nit override.
+        // The stock <=40 nit constant-rate branch requires a normal max below integer 4095.
+        // Onyx's 0.499938957 transition quantizes to 8191 and keeps the nonlinear curve.
+        if (nits <= 40f && brightnessToInt(mNormalMaximumBrightness) < 4095) {
+            return 40f / BRIGHTNESS_MAX_INT;
+        }
+        return nitRate * mNormalMaximumBrightness / normalNits;
+    }
+
+    private float getThermalRate(float current) {
+        if (mBrightness != null && mNits != null && mBrightness.length == mNits.length) {
+            for (int i = mBrightness.length - 2; i >= 0; i--) {
+                if (current >= mBrightness[i] && mNits[i + 1] > mNits[i]) {
+                    return 10f * (mBrightness[i + 1] - mBrightness[i])
+                            / (mNits[i + 1] - mNits[i]);
+                }
+            }
+        }
+        return MINIMUM_RATE;
+    }
+
+    @VisibleForTesting
+    static int getNitBand(float nits) {
+        int index = 1;
+        while (index < NITS_LEVELS.length && nits < NITS_LEVELS[index]) {
+            index++;
+        }
+        return index - 1;
+    }
+
+    @VisibleForTesting
+    static float getDurationSeconds(int mode, boolean increase) {
+        switch (mode) {
+            case DIM:
+                return 1.2f;
+            case TEMPORARY:
+                return 0.5f;
+            case HDR:
+                return 4f;
+            case DOZE_TO_ON:
+                return increase ? 0.35f : 0.8f;
+            case DOZE:
+                return 0.45f;
+            default:
+                return 0.8f;
+        }
+    }
+
+    private static boolean isPositiveFinite(float value) {
+        return value > 0 && Float.isFinite(value);
+    }
+
+    @VisibleForTesting
+    static int brightnessToInt(float brightness) {
+        return Math.round(1f + Math.max(0f, Math.min(1f, brightness))
+                * (BRIGHTNESS_MAX_INT - 1));
+    }
+
+    private static float brightnessIntToFloat(int brightness) {
+        return Math.max(0f, Math.min(1f,
+                (brightness - 1f) / (BRIGHTNESS_MAX_INT - 1)));
+    }
+}
