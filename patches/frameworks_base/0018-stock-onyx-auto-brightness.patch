+package com.android.server.display;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Before;
+import org.junit.Test;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Stock resource anchors and deterministic traces; also runnable with a host JUnit runner. */
+public class OnyxLuxPolicyTest {
+    private static final float EPSILON = .01f;
+    private final List<Update> mUpdates = new ArrayList<>();
+    private OnyxLuxPolicy mPolicy;
+
+    @Before
+    public void setUp() {
+        mUpdates.clear();
+        mPolicy = newPolicy(0);
+        mPolicy.setEnabled(true, 0);
+    }
+
+    @Test
+    public void hysteresis_matchesStockAbsoluteAnchors() {
+        OnyxLuxPolicy.Thresholds thresholds = OnyxLuxPolicy.Thresholds.stock(4475);
+        assertEquals(2, thresholds.bright(0), EPSILON);
+        assertEquals(160, thresholds.bright(30), EPSILON);
+        assertEquals(992.58f, thresholds.bright(600), EPSILON);
+        assertEquals(7538.77f, thresholds.bright(3000), EPSILON);
+        assertEquals(15.83f, thresholds.dark(30), EPSILON);
+        assertEquals(216.99f, thresholds.dark(600), EPSILON);
+        assertEquals(2052.56f, thresholds.dark(3000), EPSILON);
+    }
+
+    @Test
+    public void hysteresis_interpolatesLinearlyBetweenAnchors() {
+        OnyxLuxPolicy.Thresholds thresholds = OnyxLuxPolicy.Thresholds.stock(4475);
+        assertEquals((160 + 992.58f) / 2, thresholds.bright(315), EPSILON);
+        assertEquals((45.34f + 216.99f) / 2, thresholds.dark(480), EPSILON);
+    }
+
+    @Test
+    public void smallBrightening_blendsAnchorsAndAppliesPreviousThresholdFloor() {
+        OnyxLuxPolicy.Thresholds thresholds = OnyxLuxPolicy.Thresholds.stock(4475);
+        assertEquals(17.22f, thresholds.smallBright(9), EPSILON);
+        assertEquals(160 * .6f + 30 * .4f, thresholds.smallBright(30), EPSILON);
+        // At 15 lux the blend is 23.064, above the prior large threshold of 17.22.
+        assertEquals(23.064f, thresholds.smallBright(15), EPSILON);
+        OnyxLuxPolicy.Thresholds floor = new OnyxLuxPolicy.Thresholds(
+                new float[] {0, 10, 20}, new float[] {2, 100, 110},
+                new float[] {0, 20}, new float[] {0, 10}, .6f, 4475);
+        assertEquals(100, floor.smallBright(20), EPSILON);
+    }
+
+    @Test
+    public void highBrightnessMode_usesLuxPlusOneOnlyAboveMinimum() {
+        OnyxLuxPolicy.Thresholds thresholds = OnyxLuxPolicy.Thresholds.stock(4475);
+        float expectedAtMinimum = 7538.77f + (4475 - 3000f) / (8500 - 3000)
+                * (13038.8f - 7538.77f);
+        assertEquals(expectedAtMinimum, thresholds.bright(4475), EPSILON);
+        assertEquals(4476.1f, thresholds.bright(4475.1f), EPSILON);
+        assertEquals(6001, thresholds.smallBright(6000), EPSILON);
+    }
+
+    @Test
+    public void history_matchesStockTimeWeightIntegralAndPrediction() {
+        OnyxLuxPolicy.History history = new OnyxLuxPolicy.History(1500);
+        history.push(0, 10);
+        history.push(500, 100);
+        // At t=1000, the old interval [-1000,-500] weighs 375000, while the new
+        // interval [-500,+100] weighs 780000; +100 is the stock prediction term.
+        assertEquals((10 * 375000f + 100 * 780000f) / 1155000f,
+                history.lux(1000, 1000), EPSILON);
+        assertEquals(100, history.lux(1600, 1000), EPSILON);
+    }
+
+    @Test
+    public void history_retainsFiveSecondsForSmallDebounce() {
+        OnyxLuxPolicy.History history = new OnyxLuxPolicy.History(1500);
+        history.push(0, 30);
+        history.push(100, 120);
+        history.push(4900, 120);
+        history.prune(5099);
+        assertEquals(5100, history.transition(5099, 108, 5000, true));
+        history.prune(5100);
+        assertEquals(5100, history.transition(5100, 108, 5000, true));
+    }
+
+    @Test
+    public void history_thresholdEqualityDoesNotCountAsPersistence() {
+        OnyxLuxPolicy.History history = new OnyxLuxPolicy.History(1500);
+        history.push(0, 160);
+        assertEquals(2500, history.transition(1500, 160, 1000, true));
+        history.clear();
+        history.push(0, 15.83f);
+        assertEquals(2500, history.transition(1500, 15.83f, 1000, false));
+    }
+
+    @Test
+    public void normalBrightening_waitsOneSecondAndBothFilteredWindows() {
+        main(0, 30);
+        main(4000, 30);
+        main(4100, 300);
+        mPolicy.update(5099);
+        assertEquals(30, mPolicy.ambientLux(), EPSILON);
+        mPolicy.update(5100);
+        assertEquals(300, mPolicy.ambientLux(), EPSILON);
+        assertFalse(last().fastChange);
+    }
+
+    @Test
+    public void smallBrightening_waitsFiveSeconds() {
+        main(0, 30);
+        main(4000, 30);
+        main(4100, 120); // Between the small 108-lux and large 160-lux thresholds.
+        main(9000, 120);
+        mPolicy.update(9099);
+        assertEquals(30, mPolicy.ambientLux(), EPSILON);
+        mPolicy.update(9100);
+        assertEquals(120, mPolicy.ambientLux(), EPSILON);
+        assertFalse(last().fastChange);
+    }
+
+    @Test
+    public void assistant_initializationNeedsMainBrighteningThreshold() {
+        main(0, 30);
+        assist(0, 100);
+        assertEquals(OnyxLuxPolicy.MAIN, mPolicy.source());
+        assertEquals(30, mPolicy.ambientLux(), EPSILON);
+    }
+
+    @Test
+    public void assistant_takesOverAfterItsDebounceAndMainRecoversWhenBrighter() {
+        main(0, 30);
+        assist(0, 50);
+        main(4000, 30);
+        assist(4000, 400);
+        mPolicy.update(4999);
+        assertEquals(OnyxLuxPolicy.MAIN, mPolicy.source());
+        assist(5000, 400);
+        assertEquals(OnyxLuxPolicy.ASSIST, mPolicy.source());
+        assertEquals(400, mPolicy.ambientLux(), EPSILON);
+        main(6000, 500);
+        assist(6000, 400);
+        mPolicy.update(7000);
+        assertEquals(OnyxLuxPolicy.MAIN, mPolicy.source());
+        assertEquals(500, mPolicy.ambientLux(), EPSILON);
+    }
+
+    @Test
+    public void shadedMain_cannotDarkenBelowBrighterAssistant() {
+        main(0, 500);
+        assist(0, 450);
+        main(4000, 20);
+        assist(4000, 450);
+        mPolicy.update(5000);
+        assertEquals(OnyxLuxPolicy.ASSIST, mPolicy.source());
+        assertEquals(450, mPolicy.ambientLux(), EPSILON);
+    }
+
+    @Test
+    public void assistantDrop_switchesBackToMainAfterDarkeningDebounce() {
+        main(0, 30);
+        assist(0, 400);
+        assertEquals(OnyxLuxPolicy.ASSIST, mPolicy.source());
+        main(4000, 30);
+        assist(4000, 10);
+        mPolicy.update(5000);
+        assertEquals(OnyxLuxPolicy.MAIN, mPolicy.source());
+        assertEquals(30, mPolicy.ambientLux(), EPSILON);
+    }
+
+    @Test
+    public void invalidSamples_doNotReplaceUsableMainEstimate() {
+        main(100, 30);
+        assertFalse(mPolicy.add(OnyxLuxPolicy.MAIN, 101, Float.NaN, 101));
+        assertFalse(mPolicy.add(OnyxLuxPolicy.MAIN, 102, Float.POSITIVE_INFINITY, 102));
+        assertFalse(mPolicy.add(OnyxLuxPolicy.MAIN, 103, -1, 103));
+        assertFalse(mPolicy.add(OnyxLuxPolicy.MAIN, 99, 1000, 104));
+        assertFalse(mPolicy.add(OnyxLuxPolicy.MAIN, 200, 1000, 104));
+        assertFalse(mPolicy.add(OnyxLuxPolicy.MAIN, 100, 1000, 6000));
+        assertEquals(30, mPolicy.ambientLux(), EPSILON);
+        assertEquals(1, mUpdates.size());
+    }
+
+    @Test
+    public void dominantAssistant_keepsLastReadingAcrossLongSilence() {
+        main(0, 30);
+        assist(0, 400);
+        main(4000, 30);
+        mPolicy.update(5000);
+        assertEquals(OnyxLuxPolicy.ASSIST, mPolicy.source());
+        mPolicy.update(5001);
+        assertEquals(OnyxLuxPolicy.ASSIST, mPolicy.source());
+        assertEquals(400, mPolicy.ambientLux(), EPSILON);
+        main(180000, 30);
+        mPolicy.update(181000);
+        assertEquals(OnyxLuxPolicy.ASSIST, mPolicy.source());
+        assertEquals(400, mPolicy.ambientLux(), EPSILON);
+    }
+
+    @Test
+    public void torch_dropsContaminatedSamplesAndRetainsAcceptedRearHistory() {
+        main(0, 30);
+        assist(0, 400);
+        mPolicy.setTorch(true, 100);
+        assertEquals(OnyxLuxPolicy.ASSIST, mPolicy.source());
+        assertFalse(mPolicy.add(OnyxLuxPolicy.ASSIST, 200, 10000, 200));
+        mPolicy.setTorch(false, 1000);
+        assertFalse(mPolicy.add(OnyxLuxPolicy.ASSIST, 2800, 10000, 2800));
+        mPolicy.update(2801);
+        assertEquals(400, mPolicy.ambientLux(), EPSILON);
+        assertTrue(mPolicy.add(OnyxLuxPolicy.ASSIST, 2801, 200, 2801));
