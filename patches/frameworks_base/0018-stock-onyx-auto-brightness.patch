+        when(mSensorManager.registerListener(any(SensorEventListener.class), eq(mMainSensor),
+                eq(200000), any(Handler.class))).thenAnswer(invocation -> {
+                    registrationTime[0] = mClock.lastSensorTime;
+                    return true;
+                });
+        configure(AUTO_BRIGHTNESS_ENABLED, false);
+        SensorEventListener listener = mainListener();
+        listener.onSensorChanged(new SensorEvent(mMainSensor, 0,
+                registrationTime[0] * 1000000, new float[] {5.65f}));
+        assertTrue(mController.hasValidAmbientLux());
+        assertEquals(5.65f, mController.getAmbientLux(), .001f);
+    }
+
+    private void configure(int state, boolean oneShot) {
+        mController.configure(state, null, .5f, false, 0, false,
+                DisplayPowerRequest.POLICY_BRIGHT, Display.STATE_ON, false, false, oneShot);
+    }
+
+    private SensorEventListener mainListener() {
+        ArgumentCaptor<SensorEventListener> listener =
+                ArgumentCaptor.forClass(SensorEventListener.class);
+        verify(mSensorManager).registerListener(listener.capture(), eq(mMainSensor),
+                eq(200000), any(Handler.class));
+        return listener.getValue();
+    }
+
+    private void send(SensorEventListener listener, float lux) {
+        listener.onSensorChanged(new SensorEvent(mMainSensor, 0, mClock.elapsed * 1000000,
+                new float[] {lux}));
+    }
+
+    private static final class TestClock implements AutomaticBrightnessController.Clock {
+        long elapsed = 100000;
+        long uptime = 1000;
+        long sensorTimeStep;
+        long lastSensorTime;
+        @Override
+        public long uptimeMillis() { return uptime; }
+        @Override
+        public long getSensorEventScaleTime() {
+            lastSensorTime = elapsed;
+            elapsed += sensorTimeStep;
+            return lastSensorTime;
+        }
+        void advance(long millis) { elapsed += millis; uptime += millis; }
+    }
+}
