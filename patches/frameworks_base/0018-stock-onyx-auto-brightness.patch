+    private static void assertMatchesStockGlobalSpline(BrightnessMappingStrategy strategy,
+            Spline expectedNits, float[] luxes) {
+        float previous = -1f;
+        for (float lux : luxes) {
+            float expected = strategy.getBrightnessFromAdjustedNits(expectedNits.interpolate(lux));
+            float actual = strategy.getBrightness(lux);
+            assertEquals("Stock Global brightness at lux " + lux, expected, actual, 0.000001f);
+            assertTrue(Float.isFinite(actual) && actual >= previous && actual <= 1f);
+            previous = actual;
+        }
+    }
+
+    private static Spline stockGlobalNitsSpline(BrightnessMappingStrategy strategy, float userLux,
+            float userBrightness, float cachedUnadjustedBrightness) {
+        android.util.Pair<float[], float[]> curve = strategy.getBrightnessConfiguration().getCurve();
+        int idx = 0;
+        while (idx < curve.first.length && curve.first[idx] < userLux) {
+            idx++;
+        }
+        boolean replace = idx < curve.first.length && curve.first[idx] == userLux;
+        int size = curve.first.length + (replace ? 0 : 1);
+        float[] lux = new float[size];
+        float[] brightness = new float[size];
+        int source = 0;
+        for (int i = 0; i < size; i++) {
+            if (i == idx) {
+                lux[i] = userLux;
+                brightness[i] = userBrightness;
+                if (replace) {
+                    source++;
+                }
+            } else {
+                lux[i] = curve.first[source];
+                brightness[i] = strategy.getBrightnessFromAdjustedNits(curve.second[source++]);
+            }
+        }
+        // Reference: shipped Xiaomi Global BrightnessMappingStrategyImpl.smoothNewCurve,
+        // corroborated by the 303/305 raw smali. Keep the reference float operation order.
+        for (int i = idx + 1; i < lux.length; i++) {
+            brightness[i] = brightness[i] - (cachedUnadjustedBrightness - brightness[idx]);
+            brightness[i] = MathUtils.max(brightness[i], brightness[i - 1]);
+        }
+        for (int i = idx - 1; i >= 0; i--) {
+            brightness[i] = brightness[i]
+                    - (((cachedUnadjustedBrightness - brightness[idx]) * brightness[i])
+                            / cachedUnadjustedBrightness);
+            brightness[i] = MathUtils.min(brightness[i], brightness[i + 1]);
+        }
+        float[] nits = new float[size];
+        for (int i = 0; i < size; i++) {
+            nits[i] = strategy.convertToAdjustedNits(brightness[i]);
+        }
+        return Spline.createSpline(lux, nits);
+    }
