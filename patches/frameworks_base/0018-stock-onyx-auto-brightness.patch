+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.CameraManager;
+import android.os.Handler;
+import android.os.test.TestLooper;
+
+import androidx.test.ext.junit.runners.AndroidJUnit4;
+import androidx.test.filters.SmallTest;
+
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.ArgumentCaptor;
+import org.mockito.Mock;
+import org.mockito.MockitoAnnotations;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Tests platform registration and the elapsed-realtime to uptime scheduling boundary. */
+@SmallTest
+@RunWith(AndroidJUnit4.class)
+public class OnyxBrightnessSensorPolicyTest {
+    private static final int ASSIST_TYPE = 33171055;
+    private static final int POCKET_TYPE = 33171027;
+    private static final int RATE_MILLIS = 200;
+    private static final float EPSILON = .01f;
+
+    @Mock private Context mContext;
+    @Mock private SensorManager mSensorManager;
+    @Mock private Sensor mAssistSensor;
+    @Mock private Sensor mPocketSensor;
+    @Mock private CameraManager mCameraManager;
+    @Mock private CameraCharacteristics mRearCharacteristics;
+    @Mock private CameraCharacteristics mFrontCharacteristics;
+
+    private final List<Float> mLuxUpdates = new ArrayList<>();
+    private FakeClock mClock;
+    private TestLooper mLooper;
+    private Handler mHandler;
+    private OnyxBrightnessSensorPolicy mPolicy;
+
+    @Before
+    public void setUp() {
+        System.setProperty("dexmaker.share_classloader", "true");
+        MockitoAnnotations.initMocks(this);
+        mLuxUpdates.clear();
+        mClock = new FakeClock();
+        mLooper = new TestLooper(mClock::uptimeMillis);
+        mHandler = new Handler(mLooper.getLooper());
+        when(mSensorManager.getDefaultSensor(ASSIST_TYPE)).thenReturn(mAssistSensor);
+        when(mSensorManager.getDefaultSensor(POCKET_TYPE)).thenReturn(mPocketSensor);
+        when(mSensorManager.registerListener(any(SensorEventListener.class), any(Sensor.class),
+                anyInt(), eq(mHandler))).thenReturn(true);
+    }
+
+    @After
+    public void tearDown() {
+        if (mPolicy != null) mPolicy.stop();
+    }
+
+    @Test
+    public void optionalSensorsAbsent_mainStillSuppliesLux() {
+        when(mSensorManager.getDefaultSensor(ASSIST_TYPE)).thenReturn(null);
+        when(mSensorManager.getDefaultSensor(POCKET_TYPE)).thenReturn(null);
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        assertEquals(30, lastLux(), EPSILON);
+        mPolicy.setEnabled(false);
+        verify(mSensorManager, never()).registerListener(any(SensorEventListener.class),
+                any(Sensor.class), anyInt(), any(Handler.class));
+        verify(mSensorManager, never()).unregisterListener(any(SensorEventListener.class));
+    }
+
+    @Test
+    public void enableAndDisable_areIdempotentAndReleaseBothSensors() {
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        mPolicy.setEnabled(true);
+        SensorEventListener rear = rearListener();
+        SensorEventListener pocket = pocketListener();
+        mPolicy.setEnabled(false);
+        mPolicy.setEnabled(false);
+        verify(mSensorManager, times(1)).unregisterListener(rear);
+        verify(mSensorManager, times(1)).unregisterListener(pocket);
+        assertFalse(mPolicy.shouldUseFastRate());
+    }
+
+    @Test
+    public void reenable_registersFreshListenersWithoutOldRearLux() {
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        SensorEventListener rear = rearListener();
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        rear.onSensorChanged(event(mAssistSensor, 400));
+        assertEquals(400, lastLux(), EPSILON);
+        mPolicy.setEnabled(false);
+        mClock.advance(1000);
+        mPolicy.setEnabled(true);
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 5));
+        assertEquals(5, lastLux(), EPSILON);
+        verify(mSensorManager, times(2)).registerListener(any(SensorEventListener.class),
+                eq(mAssistSensor), eq(RATE_MILLIS * 1000), eq(mHandler));
+        verify(mSensorManager, times(2)).registerListener(any(SensorEventListener.class),
+                eq(mPocketSensor), eq(SensorManager.SENSOR_DELAY_NORMAL), eq(mHandler));
+    }
+
+    @Test
+    public void cachedRearOnChangeReading_initializesAgainAfterReenable() {
+        when(mAssistSensor.getReportingMode()).thenReturn(Sensor.REPORTING_MODE_ON_CHANGE);
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        SensorEventListener rear = rearListener();
+        SensorEvent cached = new SensorEvent(mAssistSensor, 0, 1000 * 1000000L,
+                new float[] {30});
+        rear.onSensorChanged(cached);
+        assertEquals(30, lastLux(), EPSILON);
+        mPolicy.setEnabled(false);
+        mClock.advance(1000);
+        mPolicy.setEnabled(true);
+        rear.onSensorChanged(cached);
+        assertEquals(2, mLuxUpdates.size());
+        assertEquals(30, lastLux(), EPSILON);
+    }
+
+    @Test
+    public void laterCachedRearReadings_doNotReplaceAcceptedRoomLight() {
+        when(mAssistSensor.getReportingMode()).thenReturn(Sensor.REPORTING_MODE_ON_CHANGE);
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        SensorEventListener rear = rearListener();
+        rear.onSensorChanged(new SensorEvent(mAssistSensor, 0, 1000 * 1000000L,
+                new float[] {30}));
+        rear.onSensorChanged(new SensorEvent(mAssistSensor, 0, 1001 * 1000000L,
+                new float[] {10000}));
+        mClock.advance(2000);
+        mLooper.dispatchAll();
+        assertEquals(1, mLuxUpdates.size());
+        assertEquals(30, lastLux(), EPSILON);
+    }
+
+    @Test
+    public void queuedRearCallbackAfterDisable_doesNotUpdateLuxOrSchedule() {
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        SensorEventListener rear = rearListener();
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        SensorEvent queuedEvent = event(mAssistSensor, 400);
+        mPolicy.setEnabled(false);
+        rear.onSensorChanged(queuedEvent);
+        mClock.advance(2000);
+        mLooper.dispatchAll();
+        assertEquals(1, mLuxUpdates.size());
+        assertEquals(30, lastLux(), EPSILON);
+        assertFalse(mPolicy.onMainLight(mClock.elapsed, 1000));
+    }
+
+    @Test
+    public void warmupDeadline_convertsSensorTimeToUptime() {
+        // Sensor timestamps count sleep; Handler timestamps do not. The clocks start 99s apart.
+        createPolicy(1000);
+        mPolicy.setEnabled(true);
+        assertTrue(mPolicy.onMainLight(100000, 30));
+        assertEquals(0, mLuxUpdates.size());
+        mClock.advance(999);
+        mLooper.dispatchAll();
+        assertEquals(0, mLuxUpdates.size());
+        mClock.advance(1);
+        mLooper.dispatchAll();
+        assertEquals(1, mLuxUpdates.size());
+        assertEquals(30, lastLux(), EPSILON);
+    }
+
+    @Test
+    public void disable_cancelsPendingWarmupDeadline() {
+        createPolicy(1000);
+        mPolicy.setEnabled(true);
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        mPolicy.setEnabled(false);
+        mClock.advance(1000);
+        mLooper.dispatchAll();
+        assertEquals(0, mLuxUpdates.size());
+    }
+
+    @Test
+    public void rearSensorMissing_torchServiceTracksWhileDisabledAndUnregistersOnStop()
+            throws Exception {
+        setUpCameras();
+        when(mSensorManager.getDefaultSensor(ASSIST_TYPE)).thenReturn(null);
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        mPolicy.setEnabled(true);
+        CameraManager.TorchCallback callback = torchCallback();
+        mPolicy.setEnabled(false);
+        mPolicy.setEnabled(false);
+        verify(mCameraManager, never()).unregisterTorchCallback(callback);
+        mPolicy.stop();
+        mPolicy.stop();
+        verify(mCameraManager, times(1)).unregisterTorchCallback(callback);
+    }
+
+    @Test
+    public void torchClosedWhileDisabled_doesNotRestartCooldownOnReenable() throws Exception {
+        setUpCameras();
+        createPolicy(0);
+        CameraManager.TorchCallback torch = torchCallback();
+        torch.onTorchModeChanged("rear", true);
+        mClock.advance(100);
+        torch.onTorchModeChanged("rear", false);
+        mClock.advance(1801);
+        mPolicy.setEnabled(true);
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        rearListener().onSensorChanged(event(mAssistSensor, 400));
+        assertEquals(400, lastLux(), EPSILON);
+    }
+
+    @Test
+    public void firstAutoLatch_isSeparateFromScreenOffReactivation() {
+        createPolicy(0);
+        mPolicy.setEnabled(true, true);
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        assertTrue(mPolicy.shouldUseFastRate(100, 101));
+        mPolicy.setEnabled(false);
+        mClock.advance(1000);
+        mPolicy.setEnabled(true, false);
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        assertFalse(mPolicy.shouldUseFastRate(100, 101));
+        assertTrue(mPolicy.shouldUseFastRate(100, 160));
+    }
+
+    @Test
+    public void rearTorch_excludesNewRearReadingsThrough1800msAndKeepsAcceptedLux()
+            throws Exception {
+        setUpCameras();
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        SensorEventListener rear = rearListener();
+        CameraManager.TorchCallback torch = torchCallback();
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        rear.onSensorChanged(event(mAssistSensor, 400));
+        assertEquals(400, lastLux(), EPSILON);
+        torch.onTorchModeChanged("rear", true);
+        assertEquals(400, lastLux(), EPSILON);
+        rear.onSensorChanged(event(mAssistSensor, 10000));
+        assertEquals(400, lastLux(), EPSILON);
+        mClock.advance(100);
+        torch.onTorchModeChanged("rear", false);
+        mClock.advance(1800);
+        rear.onSensorChanged(event(mAssistSensor, 10000));
+        assertEquals(400, lastLux(), EPSILON);
+        mClock.advance(1);
+        rear.onSensorChanged(event(mAssistSensor, 400));
+        assertEquals(400, lastLux(), EPSILON);
+    }
+
+    @Test
+    public void cameraFacingAlone_doesNotExcludeTorchFromStockProtection() throws Exception {
+        setUpCameras();
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        SensorEventListener rear = rearListener();
+        CameraManager.TorchCallback torch = torchCallback();
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        rear.onSensorChanged(event(mAssistSensor, 400));
+        torch.onTorchModeChanged("front", true);
+        assertEquals(400, lastLux(), EPSILON);
+        mClock.advance(100);
+        rear.onSensorChanged(event(mAssistSensor, 1300));
+        mClock.advance(1000);
+        mLooper.dispatchAll();
+        assertEquals(400, lastLux(), EPSILON);
+    }
+
+    @Test
+    public void unavailableRearTorch_excludesRearAndQueuedTorchAfterStopIsIgnored()
+            throws Exception {
+        setUpCameras();
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        SensorEventListener rear = rearListener();
+        CameraManager.TorchCallback torch = torchCallback();
+        assertTrue(mPolicy.onMainLight(mClock.elapsed, 30));
+        torch.onTorchModeUnavailable("rear");
+        rear.onSensorChanged(event(mAssistSensor, 400));
+        assertEquals(30, lastLux(), EPSILON);
+        mPolicy.stop();
+        int updatesBefore = mLuxUpdates.size();
+        torch.onTorchModeChanged("rear", false);
+        mClock.advance(2000);
+        mLooper.dispatchAll();
+        assertEquals(updatesBefore, mLuxUpdates.size());
+    }
+
+    @Test
+    public void pocketExit_reopensFastWindowAfterInitialThreeSeconds() {
+        createPolicy(0);
+        mPolicy.setEnabled(true);
+        SensorEventListener pocket = pocketListener();
+        mClock.advance(3001);
+        assertFalse(mPolicy.shouldUseFastRate());
+        pocket.onSensorChanged(event(mPocketSensor, 1));
+        pocket.onSensorChanged(event(mPocketSensor, 0));
+        assertTrue(mPolicy.shouldUseFastRate());
+        mClock.advance(2000);
+        assertTrue(mPolicy.shouldUseFastRate());
+        mClock.advance(1);
+        assertFalse(mPolicy.shouldUseFastRate());
+    }
+
+    private void createPolicy(int warmup) {
+        mPolicy = new OnyxBrightnessSensorPolicy(mContext, mSensorManager, mHandler, mClock,
+                OnyxBrightnessSensorPolicy.Config.stock(true, 4475),
+                (lux, fast, slow, fastChange) -> mLuxUpdates.add(lux),
+                1500, 1000, warmup, RATE_MILLIS, 1000, 1000);
+    }
+
+    private void setUpCameras() throws Exception {
+        when(mContext.getSystemService(CameraManager.class)).thenReturn(mCameraManager);
+        when(mCameraManager.getCameraIdList()).thenReturn(new String[] {"rear", "front"});
+        when(mCameraManager.getCameraCharacteristics("rear")).thenReturn(mRearCharacteristics);
+        when(mCameraManager.getCameraCharacteristics("front")).thenReturn(mFrontCharacteristics);
+        when(mRearCharacteristics.get(CameraCharacteristics.LENS_FACING))
+                .thenReturn(CameraCharacteristics.LENS_FACING_BACK);
+        when(mFrontCharacteristics.get(CameraCharacteristics.LENS_FACING))
+                .thenReturn(CameraCharacteristics.LENS_FACING_FRONT);
+    }
+
+    private SensorEventListener rearListener() {
+        ArgumentCaptor<SensorEventListener> captor =
+                ArgumentCaptor.forClass(SensorEventListener.class);
+        verify(mSensorManager).registerListener(captor.capture(), eq(mAssistSensor),
+                eq(RATE_MILLIS * 1000), eq(mHandler));
+        return captor.getValue();
+    }
+
+    private SensorEventListener pocketListener() {
+        ArgumentCaptor<SensorEventListener> captor =
+                ArgumentCaptor.forClass(SensorEventListener.class);
+        verify(mSensorManager).registerListener(captor.capture(), eq(mPocketSensor),
+                eq(SensorManager.SENSOR_DELAY_NORMAL), eq(mHandler));
+        return captor.getValue();
+    }
+
+    private CameraManager.TorchCallback torchCallback() {
+        ArgumentCaptor<CameraManager.TorchCallback> captor =
+                ArgumentCaptor.forClass(CameraManager.TorchCallback.class);
+        verify(mCameraManager).registerTorchCallback(captor.capture(), eq(mHandler));
+        return captor.getValue();
+    }
+
+    private SensorEvent event(Sensor sensor, float lux) {
+        return new SensorEvent(sensor, 0, mClock.elapsed * 1000000, new float[] {lux});
+    }
+
+    private float lastLux() {
+        return mLuxUpdates.get(mLuxUpdates.size() - 1);
+    }
+
+    private static final class FakeClock implements AutomaticBrightnessController.Clock {
+        long uptime = 1000;
+        long elapsed = 100000;
+
+        @Override
+        public long uptimeMillis() { return uptime; }
+
+        @Override
+        public long getSensorEventScaleTime() { return elapsed; }
+
+        void advance(long millis) {
+            uptime += millis;
+            elapsed += millis;
+        }
+    }
+}
