+                newBrightness[i] = newBrightness[i]
+                        - (unadjustedBrightness - newBrightness[idx]);
+                newBrightness[i] = MathUtils.max(newBrightness[i], newBrightness[i - 1]);
+            }
+            for (int i = idx - 1; i >= 0; i--) {
+                newBrightness[i] = newBrightness[i]
+                        - (((unadjustedBrightness - newBrightness[idx]) * newBrightness[i])
+                                / unadjustedBrightness);
+                newBrightness[i] = MathUtils.min(newBrightness[i], newBrightness[i + 1]);
+            }
+            return Pair.create(newLux, newBrightness);
+        }
