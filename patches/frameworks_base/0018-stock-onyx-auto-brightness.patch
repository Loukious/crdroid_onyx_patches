+    @Test
+    public void testOnyxReduceBrightColorsRetainsCubicAdjustedConversion() {
+        BrightnessMappingStrategy strategy = createOnyxMappingStrategy(true, true);
+        float[] adjustedNits = {0f, 5f, 50f, 400f};
+        strategy.recalculateSplines(true, adjustedNits);
+        float expectedAdjustedNits = Spline.createSpline(ONYX_PANEL_BRIGHTNESS, adjustedNits)
+                .interpolate(0.3f);
+        assertEquals(55f, strategy.convertToNits(0.3f), TOLERANCE);
+        assertEquals(expectedAdjustedNits, strategy.convertToAdjustedNits(0.3f), TOLERANCE);
+        assertNotEquals(27.5f, strategy.convertToAdjustedNits(0.3f), TOLERANCE);
+        assertEquals(Spline.createSpline(adjustedNits, ONYX_PANEL_BRIGHTNESS).interpolate(25f),
+                strategy.getBrightnessFromAdjustedNits(25f), TOLERANCE);
+        strategy.recalculateSplines(false, adjustedNits);
+        assertEquals(55f, strategy.convertToAdjustedNits(0.3f), TOLERANCE);
+        assertEquals(0.3f, strategy.getBrightnessFromAdjustedNits(55f), TOLERANCE);
+    }
