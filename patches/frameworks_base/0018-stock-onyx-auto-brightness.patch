+package com.android.server.display;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+/** Exercises the actual adapter timestamp helper without Android runtime dependencies. */
+public class OnyxBrightnessSensorSampleTimeTest {
+    @Test
+    public void cachedInitialMainReading_preventsRearZeroFromReplacingSteadyRoomLight() {
+        OnyxLuxPolicy.SampleTime main = new OnyxLuxPolicy.SampleTime();
+        OnyxLuxPolicy.SampleTime rear = new OnyxLuxPolicy.SampleTime();
+        // The device trace: 5.65 lux remained unchanged for minutes before auto was re-enabled.
+        long enableTime = 1464620;
+        long now = 1464630;
+        OnyxLuxPolicy policy = policy(enableTime);
+        main.registered(enableTime, true);
+        rear.registered(enableTime, true);
+        assertFalse(policy.add(OnyxLuxPolicy.MAIN, 1252471, 5.65f, now));
+        long mainTime = main.normalize(1252471, 5.65f, now);
+        assertEquals(now, mainTime);
+        assertTrue(policy.add(OnyxLuxPolicy.MAIN, mainTime, 5.65f, now));
+        long rearTime = rear.normalize(1252472, 0, now);
+        assertTrue(policy.add(OnyxLuxPolicy.ASSIST, rearTime, 0, now));
+        assertEquals(OnyxLuxPolicy.MAIN, policy.source());
+        assertEquals(5.65f, policy.ambientLux(), .001f);
+    }
+
+    @Test
+    public void laterDelayedAndOutOfOrderReadings_keepPolicyRejection() {
+        OnyxLuxPolicy.SampleTime time = new OnyxLuxPolicy.SampleTime();
+        OnyxLuxPolicy policy = policy(100000);
+        time.registered(100000, true);
+        assertTrue(policy.add(OnyxLuxPolicy.MAIN,
+                time.normalize(90000, 30, 100010), 30, 100010));
+        // The special treatment is one initial observation, not a bypass for queued samples.
+        long outOfOrder = time.normalize(100005, 1000, 100020);
+        assertEquals(100005, outOfOrder);
+        assertFalse(policy.add(OnyxLuxPolicy.MAIN, outOfOrder, 1000, 100020));
+        long stale = time.normalize(100011, 1000, 106000);
+        assertEquals(100011, stale);
+        assertFalse(policy.add(OnyxLuxPolicy.MAIN, stale, 1000, 106000));
+        assertEquals(30, policy.ambientLux(), .001f);
+    }
+
+    @Test
+    public void continuousSensor_doesNotRetimestampOldInitialReading() {
+        OnyxLuxPolicy.SampleTime time = new OnyxLuxPolicy.SampleTime();
+        time.registered(100000, false);
+        long original = time.normalize(90000, 30, 100010);
+        assertEquals(90000, original);
+        assertFalse(policy(100000).add(OnyxLuxPolicy.MAIN, original, 30, 100010));
+    }
+
+    @Test
+    public void invalidInitialReadings_doNotConsumeCachedReadingAllowance() {
+        OnyxLuxPolicy.SampleTime time = new OnyxLuxPolicy.SampleTime();
+        time.registered(100000, true);
+        assertEquals(OnyxLuxPolicy.SampleTime.INVALID,
+                time.normalize(90000, Float.NaN, 100010));
+        assertEquals(OnyxLuxPolicy.SampleTime.INVALID,
+                time.normalize(90000, Float.POSITIVE_INFINITY, 100010));
+        assertEquals(OnyxLuxPolicy.SampleTime.INVALID,
+                time.normalize(90000, -1, 100010));
+        assertEquals(OnyxLuxPolicy.SampleTime.INVALID,
+                time.normalize(-1, 30, 100010));
+        assertEquals(OnyxLuxPolicy.SampleTime.INVALID,
+                time.normalize(100011, 30, 100010));
+        assertEquals(100010, time.normalize(90000, 30, 100010));
+    }
+
+    @Test
+    public void freshInitialReading_preservesItsHardwareTimestamp() {
+        OnyxLuxPolicy.SampleTime time = new OnyxLuxPolicy.SampleTime();
+        time.registered(100000, true);
+        assertEquals(100001, time.normalize(100001, 30, 100010));
+        assertEquals(90000, time.normalize(90000, 30, 100020));
+    }
+
+    @Test
+    public void newRegistration_acceptsItsOwnCachedReadingAfterDisable() {
+        OnyxLuxPolicy.SampleTime time = new OnyxLuxPolicy.SampleTime();
+        time.registered(100000, true);
+        assertEquals(100010, time.normalize(90000, 30, 100010));
+        time.clear();
+        assertEquals(90000, time.normalize(90000, 30, 200000));
+        time.registered(200000, true);
+        assertEquals(200010, time.normalize(90000, 30, 200010));
+        assertEquals(90000, time.normalize(90000, 30, 200020));
+    }
+
+    private static OnyxLuxPolicy policy(long enableTime) {
+        OnyxLuxPolicy policy = new OnyxLuxPolicy(OnyxLuxPolicy.Thresholds.stock(4475),
+                (lux, fast, slow, fastChange) -> { }, 1500, 1000, 0, 200, 1000, 1000,
+                5000, 3000, 2000, 1800);
+        policy.setEnabled(true, enableTime);
+        return policy;
+    }
+}
