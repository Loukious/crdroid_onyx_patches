+        state.ambientUpdated(0);
+        assertTrue(state.shouldUse(100, false, 100, 200));
+        assertFalse(state.shouldUse(200, false, 110, 180));
+        state.ambientUpdated(300);
+        assertFalse(state.shouldUse(300, false, 110, 200));
+        state.reset();
+        state.ambientUpdated(400);
+        assertTrue(state.shouldUse(400, false, 100, 180));
+    }
