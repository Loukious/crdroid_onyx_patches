+                if (value <= 51.0f) {
+                    animation.removeUpdateListener(this)
+                    toIconDrawable.alpha = 0
+                    iconView.setImageDrawable(toIconDrawable)
+                    AmbientIndicationAnimationUtils.animateDrawableAlpha(
