+    @Test
+    public void testWritePoolsFreshNotificationsAndDropsStaleStrings() throws Exception {
+        NotificationHistory history = new NotificationHistory();
+        history.addPooledStrings(Arrays.asList("stale-string"));
+        history.addNewNotificationToWrite(getHistoricalNotification("shared.package", 1));
+        history.addNewNotificationToWrite(getHistoricalNotification("shared.package", 2));
+
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        NotificationHistoryProtoHelper.write(out, history, 1);
+        ProtoInputStream proto = new ProtoInputStream(out.toByteArray());
+        List<String> writtenPool = new ArrayList<>();
+        int declaredSize = -1;
+        while (proto.nextField() != ProtoInputStream.NO_MORE_FIELDS) {
+            if (proto.getFieldNumber() != (int) NotificationHistoryProto.STRING_POOL) continue;
+            long token = proto.start(NotificationHistoryProto.STRING_POOL);
+            while (proto.nextField() != ProtoInputStream.NO_MORE_FIELDS) {
+                if (proto.getFieldNumber() == (int) NotificationHistoryProto.StringPool.SIZE) {
+                    declaredSize = proto.readInt(NotificationHistoryProto.StringPool.SIZE);
+                } else if (proto.getFieldNumber()
+                        == (int) NotificationHistoryProto.StringPool.STRINGS) {
+                    writtenPool.add(proto.readString(NotificationHistoryProto.StringPool.STRINGS));
+                }
+            }
+            proto.end(token);
+        }
+        assertThat(writtenPool).containsExactly(
+                "shared.package", "channelId1", "channelId2", "channelName2", "convo2");
+        assertThat(declaredSize).isEqualTo(writtenPool.size());
+    }
