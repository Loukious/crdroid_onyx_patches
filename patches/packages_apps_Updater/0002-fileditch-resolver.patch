+    /**
+     * Builds the DownloadClient for a download start or resume. Runs on a
+     * worker thread because FileDitch landing pages must be resolved to a
+     * short-lived direct URL first, which runs a WebView on the main thread
+     * and can take a few seconds.
+     */
+    private void beginDownloadClient(final DownloadEntry entry, final String downloadId,
+            final boolean resume) {
+        final Update update = entry.mUpdate;
+        new Thread(() -> {
+            String url = update.getDownloadUrl();
+            if (FileDitchResolver.isFileDitchUrl(url)) {
+                Log.d(TAG, "FileDitch link, solving challenge for direct URL");
+                String direct = FileDitchResolver.resolve(mContext, url);
+                if (direct != null) {
+                    url = direct;
+                } else {
+                    String fallback = update.getDownloadUrlSf();
+                    if (fallback != null && !fallback.isEmpty()) {
+                        Log.d(TAG, "Falling back to SourceForge mirror");
+                        url = fallback;
+                    } else {
+                        Log.e(TAG, "Could not resolve FileDitch link and no mirror to fall back to");
+                        downloadFailed(downloadId);
+                        return;
+                    }
+                }
+            }
+            DownloadClient downloadClient;
+            try {
+                downloadClient = new DownloadClient.Builder()
+                        .setUrl(url)
+                        .setDestination(update.getFile())
