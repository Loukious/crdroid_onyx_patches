 }
 
+bool destroy_mountpoint_metadata_key(const std::string& mount_point) {
+    const auto* entry = GetEntryForMountPoint(&fstab_default, mount_point);
+    if (entry == nullptr || entry->metadata_key_dir.empty()) {
+        LOG(ERROR) << "No metadata key directory for mount point";
+        return false;
+    }
+    bool success = android::vold::destroyKey(entry->metadata_key_dir + "/key");
+    const auto temporary_key = entry->metadata_key_dir + "/tmp";
+    if (android::vold::pathExists(temporary_key)) {
+        success &= android::vold::destroyKey(temporary_key);
+    }
+    return success;
+}
