+++ b/src/com/android/settings/security/securespaces/SecureAuthDuressViewModel.java
@@ -0,0 +1,249 @@
+/* Copyright (C) 2026 The Evolution X Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.security.securespaces;
+
+import android.app.Application;
+import android.os.SystemClock;
+
+import androidx.lifecycle.AndroidViewModel;
+import androidx.lifecycle.LiveData;
+import androidx.lifecycle.MutableLiveData;
+
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.concurrent.Executor;
+import java.util.function.LongSupplier;
+
+/** In-memory configuration transaction. Credentials never enter saved state or preferences. */
+public final class SecureAuthDuressViewModel extends AndroidViewModel {
+    static final int READ = 1;
+    static final int SET = 2;
+    static final int DELETE = 3;
+    private static final long CONFIRMATION_LIFETIME = 30_000;
+
+    public static final class State {
+        final boolean busy;
+        final boolean authorized;
+        final boolean configured;
+        final boolean failed;
+
+        State(boolean busy, boolean authorized, boolean configured, boolean failed) {
+            this.busy = busy;
+            this.authorized = authorized;
+            this.configured = configured;
+            this.failed = failed;
+        }
+    }
+
+    private final SecureSpaceRepository mRepository;
+    interface Backend {
+        boolean hasCredentials(LockscreenCredential owner);
+        void setCredentials(LockscreenCredential owner, LockscreenCredential pin,
+                LockscreenCredential password);
+    }
+
+    private final Backend mBackend;
+    private final Executor mBackground;
+    private final Executor mMain;
+    private final LongSupplier mClock;
+    private final MutableLiveData<State> mState =
+            new MutableLiveData<>(new State(false, false, false, false));
+    private boolean mForeground;
+    private boolean mWaitingForConfirmation;
+    private int mPurpose;
+    private long mGeneration;
+    private long mRunningGeneration;
+    private long mConfirmedAt;
+    private boolean mEnrollmentStarted;
+    private long mEnrollmentStartedAt;
+    private LockscreenCredential mOwnerCredential;
+    private LockscreenCredential mPin;
+    private LockscreenCredential mPassword;
+
+    public SecureAuthDuressViewModel(Application application) {
+        this(application, new SecureSpaceRepository(application), nativeBackend(application),
+                ThreadUtils::postOnBackgroundThread, ThreadUtils::postOnMainThread,
+                SystemClock::elapsedRealtime);
+    }
+
+    SecureAuthDuressViewModel(Application application, SecureSpaceRepository repository,
+            Backend backend, Executor background, Executor main, LongSupplier clock) {
+        super(application);
+        mRepository = repository;
+        mBackend = backend;
+        mBackground = background;
+        mMain = main;
+        mClock = clock;
+    }
+
+    private static Backend nativeBackend(Application application) {
+        LockPatternUtils locks = new LockPatternUtils(application);
+        return new Backend() {
+            public boolean hasCredentials(LockscreenCredential owner) {
+                return locks.hasSecureAuthDuressCredentials(owner);
+            }
+            public void setCredentials(LockscreenCredential owner, LockscreenCredential pin,
+                    LockscreenCredential password) {
+                locks.setSecureAuthDuressCredentials(owner, pin, password);
+            }
+        };
+    }
+
+    LiveData<State> getState() { return mState; }
+    boolean isOwner() { return mRepository.isOwner(); }
+    boolean hasOwnerCredential() { return mRepository.hasOwnerCredential(); }
+    boolean hasOwnerRoutingCredential() { return mRepository.hasOwnerRoutingCredential(); }
+    boolean canDisclose() { return mForeground && mState.getValue().authorized; }
+
+    void onForeground() {
+        mForeground = true;
+        dispatchConfirmedAction();
+    }
+
+    void onBackground() {
+        mForeground = false;
+        ++mGeneration;
+        State state = mState.getValue();
+        mState.setValue(new State(state.busy, false, false, state.failed));
+        // A returned proof cannot be carried through another background transition.
+        if (mOwnerCredential != null) cancelPendingAction();
+    }
+
+    boolean stageRead() { return stage(READ, null, null); }
+
+    /** Takes ownership of the two credentials only on success. */
+    boolean stageSet(LockscreenCredential pin, LockscreenCredential password) {
+        return stage(SET, pin, password);
+    }
+
+    boolean beginEnrollment() {
+        if (!canDisclose() || mState.getValue().busy) return false;
+        mEnrollmentStarted = true;
+        mEnrollmentStartedAt = mClock.getAsLong();
+        return true;
+    }
+
+    /** Collecting new secrets is not authentication; commit still needs fresh native owner proof. */
+    boolean stageEnrollment(LockscreenCredential pin, LockscreenCredential password) {
+        long now = mClock.getAsLong();
+        if (!mEnrollmentStarted || now < mEnrollmentStartedAt
+                || now - mEnrollmentStartedAt >= 300_000 || pin == null || !pin.isPin()
+                || password == null || !password.isPassword()) return false;
+        boolean staged = stage(SET, pin, password, true);
+        if (staged) mEnrollmentStarted = false;
+        return staged;
+    }
+
+    boolean stageDelete() { return stage(DELETE, null, null); }
+
+    private boolean stage(int purpose, LockscreenCredential pin, LockscreenCredential password) {
+        return stage(purpose, pin, password, false);
+    }
+
+    private boolean stage(int purpose, LockscreenCredential pin, LockscreenCredential password,
+            boolean enrollment) {
+        if (!mForeground || mState.getValue().busy || !isOwner() || !hasOwnerCredential()
+                || (purpose != READ && !canDisclose() && !enrollment)) return false;
+        mPurpose = purpose;
+        mPin = pin;
+        mPassword = password;
+        mWaitingForConfirmation = true;
+        State state = mState.getValue();
+        mState.setValue(new State(true, state.authorized, state.configured, false));
+        return true;
+    }
+
+    void onOwnerConfirmation(LockscreenCredential credential) {
+        if (!mWaitingForConfirmation || credential == null || credential.isNone()) {
+            close(credential);
+            if (mWaitingForConfirmation) cancelPendingAction();
+            return;
+        }
+        mWaitingForConfirmation = false;
+        mOwnerCredential = credential;
+        mConfirmedAt = mClock.getAsLong();
+        dispatchConfirmedAction();
+    }
+
+    private void dispatchConfirmedAction() {
+        if (!mForeground || mOwnerCredential == null) return;
+        long now = mClock.getAsLong();
+        if (now < mConfirmedAt || now - mConfirmedAt >= CONFIRMATION_LIFETIME
+                || !isOwner()) {
+            cancelPendingAction();
+            return;
+        }
+        final int purpose = mPurpose;
+        final LockscreenCredential owner = mOwnerCredential;
+        final LockscreenCredential pin = mPin;
+        final LockscreenCredential password = mPassword;
+        mOwnerCredential = null;
+        mPin = null;
+        mPassword = null;
+        mPurpose = 0;
+        final long generation = ++mGeneration;
+        mRunningGeneration = generation;
+        mBackground.execute(() -> {
+            boolean configured = false;
+            boolean failed = false;
+            try {
+                if (purpose == READ) {
+                    configured = mBackend.hasCredentials(owner);
+                } else if (purpose == SET) {
+                    mBackend.setCredentials(owner, pin, password);
+                    configured = true;
+                } else if (purpose == DELETE) {
+                    try (LockscreenCredential nonePin = LockscreenCredential.createNone();
+                            LockscreenCredential nonePassword = LockscreenCredential.createNone()) {
+                        mBackend.setCredentials(owner, nonePin, nonePassword);
+                    }
+                } else {
+                    throw new IllegalStateException("Missing configuration action");
+                }
+            } catch (RuntimeException error) {
+                failed = true;
+            } finally {
+                close(owner);
+                close(pin);
+                close(password);
+            }
+            final boolean result = configured;
+            final boolean error = failed;
+            mMain.execute(() -> {
+                if (mRunningGeneration != generation) return;
+                mRunningGeneration = 0;
+                boolean current = mForeground && generation == mGeneration && isOwner();
+                // Never restore protected status from a completion queued before onStop.
+                mState.setValue(new State(false, current && !error,
+                        current && !error && result, current && error));
+            });
+        });
+    }
+
+    void cancelPendingAction() {
+        mEnrollmentStarted = false;
+        close(mOwnerCredential);
+        close(mPin);
+        close(mPassword);
+        mOwnerCredential = null;
+        mPin = null;
+        mPassword = null;
+        mPurpose = 0;
+        mWaitingForConfirmation = false;
+        ++mGeneration;
+        mState.setValue(new State(mRunningGeneration != 0, false, false, false));
+    }
+
+    private static void close(LockscreenCredential credential) {
+        if (credential != null) credential.close();
+    }
+
+    @Override
+    protected void onCleared() {
+        mForeground = false;
+        cancelPendingAction();
+    }
+}
diff --git a/src/com/android/settings/security/securespaces/SecureSpaceLockSettings.java b/src/com/android/settings/security/securespaces/SecureSpaceLockSettings.java
new file mode 100644
index 0000000..40ee371
--- /dev/null
+++ b/src/com/android/settings/security/securespaces/SecureSpaceLockSettings.java
@@ -0,0 +1,186 @@
+/* Copyright (C) 2026 The Evolution X Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.settings.security.securespaces;
+
+import android.app.Activity;
+import android.app.admin.DevicePolicyManager;
+import android.app.settings.SettingsEnums;
+import android.content.Intent;
+import android.content.pm.UserInfo;
+import android.os.Bundle;
+import android.os.UserHandle;
+import android.os.UserManager;
+import android.view.View;
+import android.view.WindowManager;
+import android.widget.Toast;
+import androidx.lifecycle.ViewModelProvider;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import com.android.internal.widget.LockPatternUtils;
+import com.android.internal.widget.LockscreenCredential;
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.Utils;
+import com.android.settings.password.ChooseLockPassword;
+import com.android.settings.password.ChooseLockSettingsHelper;
+
+/** Xiaomi-style lock-then-fingerprint setup using the ROM's native credential screens. */
+public final class SecureSpaceLockSettings extends SettingsPreferenceFragment {
+    public static final String ARG_USER_ID = "secure_space_user_id";
+    public static final String ARG_SERIAL = "secure_space_serial";
+    private static final int CONFIRM_OWNER = 321;
+    private static final int CHOOSE_CREDENTIAL = 322;
+    private static final int CONFIRM_FINGERPRINT = 323;
+    private static final int CONFIRM_OPEN = 324;
+    private SecureSpaceLockViewModel mModel;
+    private LockscreenCredential mPendingCredential;
+    private int mPendingOpen;
+    private long mPendingOpenAt;
+    private int mUserId;
+    private int mSerial;
+
+    @Override public void onCreate(Bundle state) {
+        super.onCreate(state);
+        mModel = new ViewModelProvider(this).get(SecureSpaceLockViewModel.class);
+        Bundle args = getArguments();
+        mUserId = args == null ? -1 : args.getInt(ARG_USER_ID, -1);
+        mSerial = args == null ? -1 : args.getInt(ARG_SERIAL, -1);
+        try { mModel.setIdentity(mUserId, mSerial); }
+        catch (IllegalArgumentException invalid) { finish(); }
+    }
+    @Override public void onViewCreated(View view, Bundle state) {
+        super.onViewCreated(view, state);
+        getActivity().getWindow().addFlags(WindowManager.LayoutParams.FLAG_SECURE);
+        mModel.getState().observe(getViewLifecycleOwner(), this::render);
+    }
+    @Override public void onResume() {
+        super.onResume();
+        getActivity().setTitle(getText(R.string.secure_spaces_lock_and_fingerprint));
+        if (!mModel.isOwner()) { finish(); return; }
+        mModel.onForeground();
+        if (mPendingCredential != null) {
+            LockscreenCredential credential = mPendingCredential;
+            mPendingCredential = null;
+            if (mModel.stage(credential)) launchConfirmation(CONFIRM_OWNER, true);
+            else {
+                credential.close();
+                Toast.makeText(getContext(), R.string.secure_spaces_operation_failed,
+                        Toast.LENGTH_SHORT).show();
+            }
+        }
+        if (mPendingOpen != 0) {
+            int action = mPendingOpen;
+            mPendingOpen = 0;
+            long age = android.os.SystemClock.elapsedRealtime() - mPendingOpenAt;
+            if (age >= 0 && age < 30_000) openSpace(action == CONFIRM_FINGERPRINT);
+        }
+        render(mModel.getState().getValue());
+    }
+    @Override public void onStop() {
+        mModel.onBackground();
+        setPreferenceScreen(getPreferenceManager().createPreferenceScreen(getPrefContext()));
+        super.onStop();
+    }
+    @Override public void onDestroy() {
+        if (mPendingCredential != null) mPendingCredential.close();
+        super.onDestroy();
+    }
+    @Override public int getMetricsCategory() { return SettingsEnums.SECURITY; }
+    private void render(SecureSpaceLockViewModel.State state) {
+        if (!isAdded()) return;
+        PreferenceScreen screen = getPreferenceManager().createPreferenceScreen(getPrefContext());
+        setPreferenceScreen(screen);
+        Preference description = new Preference(getPrefContext());
+        description.setSelectable(false);
+        description.setSummary(mModel.isConfigured() ? R.string.secure_spaces_fingerprint_description
+                : mModel.canConfigure() ? R.string.secure_spaces_initial_lock_description
+                : R.string.secure_spaces_owner_lock_required);
+        screen.addPreference(description);
+        if (!mModel.canConfigure()) return;
+        if (mModel.isConfigured()) {
+            if (Utils.hasFingerprintHardware(getContext())) {
+                addAction(screen, R.string.secure_spaces_set_fingerprint,
+                        () -> launchConfirmation(CONFIRM_FINGERPRINT, false));
+            }
+            addAction(screen, R.string.secure_spaces_open,
+                    () -> launchConfirmation(CONFIRM_OPEN, false));
+        } else {
+            boolean pin = mModel.getOwnerCredentialType() == LockPatternUtils.CREDENTIAL_TYPE_PIN;
+            addAction(screen, pin ? R.string.secure_spaces_set_pin
+                    : R.string.secure_spaces_set_password, () -> chooseCredential(pin));
+        }
+        if (state.failed) {
+            Preference error = new Preference(getPrefContext());
+            error.setSummary(R.string.secure_spaces_operation_failed);
+            error.setSelectable(false);
+            screen.addPreference(error);
+        }
+        screen.setEnabled(!state.busy);
+    }
+    private void addAction(PreferenceScreen screen, int title, Runnable action) {
+        Preference choice = new Preference(getPrefContext());
+        choice.setTitle(title);
+        choice.setOnPreferenceClickListener(ignored -> { action.run(); return true; });
+        screen.addPreference(choice);
+    }
+    private void chooseCredential(boolean pin) {
+        if (!mModel.canConfigure() || mModel.getState().getValue().busy) return;
+        Intent intent = new ChooseLockPassword.IntentBuilder(getContext())
+                .setUserId(UserHandle.USER_SYSTEM)
+                .setPasswordType(pin ? DevicePolicyManager.PASSWORD_QUALITY_NUMERIC
+                        : DevicePolicyManager.PASSWORD_QUALITY_ALPHABETIC).build();
+        intent.putExtra(ChooseLockPassword.EXTRA_COLLECT_CREDENTIAL, true);
+        intent.putExtra(ChooseLockPassword.EXTRA_COLLECT_DESCRIPTION,
+                getString(R.string.secure_spaces_initial_lock_description));
+        startActivityForResult(intent, CHOOSE_CREDENTIAL);
+    }
+    private void launchConfirmation(int request, boolean returnCredential) {
+        boolean launched = new ChooseLockSettingsHelper.Builder(getActivity(), this)
+                .setRequestCode(request)
+                .setTitle(getText(R.string.secure_spaces_initial_lock_title))
+                .setUserId(UserHandle.USER_SYSTEM).setForceVerifyPath(false)
+                .setForegroundOnly(true).setReturnCredentials(returnCredential).show();
+        if (!launched) mModel.cancel();
+    }
+    private void openSpace(boolean fingerprint) {
+        try {
+            UserInfo target = getContext().getSystemService(UserManager.class).getUserInfo(mUserId);
+            if (target == null || target.serialNumber != mSerial) {
+                throw new IllegalStateException("Space identity changed");
+            }
+            SecureSpaceRepository repository = new SecureSpaceRepository(getContext());
+            if (fingerprint) {
+                Toast.makeText(getContext(), R.string.secure_spaces_fingerprint_unlock,
+                        Toast.LENGTH_LONG).show();
+                repository.switchToSpaceAndEnrollFingerprint(getContext(), target);
+            } else repository.switchToSpace(target);
+        } catch (RuntimeException failure) {
+            Toast.makeText(getContext(), R.string.secure_spaces_operation_failed,
+                    Toast.LENGTH_SHORT).show();
+        }
+    }
+    @Override public void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (requestCode == CONFIRM_FINGERPRINT || requestCode == CONFIRM_OPEN) {
+            if (resultCode == Activity.RESULT_OK) {
+                mPendingOpen = requestCode;
+                mPendingOpenAt = android.os.SystemClock.elapsedRealtime();
+            }
+            return;
+        }
+        if (requestCode != CONFIRM_OWNER && requestCode != CHOOSE_CREDENTIAL) return;
+        LockscreenCredential credential = data == null ? null : data.getParcelableExtra(
+                ChooseLockSettingsHelper.EXTRA_KEY_PASSWORD, LockscreenCredential.class);
+        if (data != null) data.removeExtra(ChooseLockSettingsHelper.EXTRA_KEY_PASSWORD);
+        if (resultCode != Activity.RESULT_OK || credential == null) {
+            if (credential != null) credential.close();
+            mModel.cancel();
+            return;
+        }
+        if (requestCode == CHOOSE_CREDENTIAL) {
+            if (mPendingCredential != null) mPendingCredential.close();
+            mPendingCredential = credential;
+        } else mModel.onOwnerConfirmation(credential);
+    }
+}
diff --git a/src/com/android/settings/security/securespaces/SecureSpaceLockViewModel.java b/src/com/android/settings/security/securespaces/SecureSpaceLockViewModel.java
