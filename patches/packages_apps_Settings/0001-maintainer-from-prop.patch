         val overlayMaintainer = safeGetString(context, R.string.build_maintainer_summary).trim()
         val overlayDonateUrl = safeGetString(context, R.string.build_maintainer_donate_url)
 
+        // An unofficial build names its own builder, and that wins outright.
+        //
+        // The OTA lookup below is keyed on the device codename alone, so on any
+        // device that has official support -- and this one does -- it would
+        // replace the local name with the official maintainer's and repoint the
+        // donate link at their PayPal. Setting the property also skips the
+        // fetch entirely, since there is nothing on the OTA server that
+        // describes this build.
+        val propMaintainer = SystemProperties.get(PROP_MAINTAINER, "").trim()
+        if (propMaintainer.isNotEmpty()) {
+            resolvedMaintainer = propMaintainer
+            val propDonateUrl = SystemProperties.get(PROP_DONATE_URL, "").trim()
+            resolvedDonateUrl =
+                sanitizeUrlOrNull(if (propDonateUrl.isNotEmpty()) propDonateUrl else overlayDonateUrl)
+            fetchStarted = true
+            applyState(preference)
+            return
+        }
+
         if (resolvedMaintainer.isEmpty()) {
             resolvedMaintainer = overlayMaintainer
         }
