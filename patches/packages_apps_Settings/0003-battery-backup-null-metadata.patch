+package com.android.settings.fuelgauge;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import static java.nio.charset.StandardCharsets.UTF_8;
+
+import android.app.Application;
+import android.app.backup.BackupDataOutput;
+import android.os.Binder;
+import android.os.Build;
+import android.os.IBinder;
+import android.os.IDeviceIdleController;
+import android.os.ServiceManager;
+
+import com.android.settings.overlay.FeatureFactory;
+import com.android.settingslib.datastore.BackupContext;
+import com.android.settingslib.datastore.BackupRestoreEntity;
+import com.android.settingslib.datastore.EntityBackupResult;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.RuntimeEnvironment;
+import org.robolectric.annotation.Config;
+import org.robolectric.annotation.Implementation;
+import org.robolectric.annotation.Implements;
+import org.robolectric.annotation.Resetter;
+import org.robolectric.shadows.ShadowServiceManager;
+
+import java.io.ByteArrayOutputStream;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(
+        application = Application.class,
+        shadows = BatterySettingsStorageTest.ShadowDeviceIdleService.class)
+public class BatterySettingsStorageTest {
+    private BatterySettingsStorage mStorage;
+    private PowerUsageFeatureProvider mProvider;
+    private BackupContext mBackupContext;
+
+    @Before
+    public void setUp() throws Exception {
+        final IDeviceIdleController deviceIdleController = mock(IDeviceIdleController.class);
+        when(deviceIdleController.getFullPowerWhitelist()).thenReturn(new String[0]);
+        final Binder binder = new Binder();
+        binder.attachInterface(deviceIdleController, "android.os.IDeviceIdleController");
+        ShadowDeviceIdleService.sDeviceIdleService = binder;
+
+        final Application application = RuntimeEnvironment.getApplication();
+        final FeatureFactory factory = mock(FeatureFactory.class);
+        mProvider = mock(PowerUsageFeatureProvider.class);
+        when(factory.getPowerUsageFeatureProvider()).thenReturn(mProvider);
+        FeatureFactory.setFactory(application, factory);
+        mStorage = new BatterySettingsStorage(application);
+        mBackupContext = new BackupContext(mock(BackupDataOutput.class));
+    }
+
+    @Test
+    public void backup_nullMetadata1_deletesEntityWithoutWritingPayload() throws Exception {
+        assertBackup(BatterySettingsStorage.KEY_BUILD_METADATA_1, EntityBackupResult.DELETE, "");
+    }
+
+    @Test
+    public void backup_nullMetadata2_deletesEntityWithoutWritingPayload() throws Exception {
+        assertBackup(BatterySettingsStorage.KEY_BUILD_METADATA_2, EntityBackupResult.DELETE, "");
+    }
+
+    @Test
+    public void backup_presentMetadata_writesUtf8() throws Exception {
+        when(mProvider.getBuildMetadata1(any())).thenReturn("device-\u03b1");
+        when(mProvider.getBuildMetadata2(any())).thenReturn("build-\u4e8c");
+
+        assertBackup(
+                BatterySettingsStorage.KEY_BUILD_METADATA_1,
+                EntityBackupResult.UPDATE,
+                "device-\u03b1");
+        assertBackup(
+                BatterySettingsStorage.KEY_BUILD_METADATA_2,
+                EntityBackupResult.UPDATE,
+                "build-\u4e8c");
+    }
+
+    @Test
+    public void backup_emptyMetadata_updatesRatherThanDeletesEntity() throws Exception {
+        when(mProvider.getBuildMetadata1(any())).thenReturn("");
+        when(mProvider.getBuildMetadata2(any())).thenReturn("");
+
+        assertBackup(BatterySettingsStorage.KEY_BUILD_METADATA_1, EntityBackupResult.UPDATE, "");
+        assertBackup(BatterySettingsStorage.KEY_BUILD_METADATA_2, EntityBackupResult.UPDATE, "");
+    }
+
+    @Test
+    public void backup_standardBuildInfo_writesCurrentValues() throws Exception {
+        assertBackup(
+                BatterySettingsStorage.KEY_BUILD_BRAND, EntityBackupResult.UPDATE, Build.BRAND);
+        assertBackup(
+                BatterySettingsStorage.KEY_BUILD_PRODUCT, EntityBackupResult.UPDATE, Build.PRODUCT);
+        assertBackup(
+                BatterySettingsStorage.KEY_BUILD_MANUFACTURER,
+                EntityBackupResult.UPDATE,
+                Build.MANUFACTURER);
+        assertBackup(
+                BatterySettingsStorage.KEY_BUILD_FINGERPRINT,
+                EntityBackupResult.UPDATE,
+                Build.FINGERPRINT);
+    }
+
+    private void assertBackup(String key, EntityBackupResult result, String payload)
+            throws Exception {
+        final BackupRestoreEntity entity =
+                mStorage.createBackupRestoreEntities().stream()
+                        .filter(candidate -> key.equals(candidate.getKey()))
+                        .findFirst()
+                        .orElseThrow();
+        final ByteArrayOutputStream output = new ByteArrayOutputStream();
+
+        assertThat(entity.backup(mBackupContext, output)).isEqualTo(result);
+        assertThat(output.toByteArray()).isEqualTo(payload.getBytes(UTF_8));
+    }
+
+    @Implements(ServiceManager.class)
+    public static class ShadowDeviceIdleService extends ShadowServiceManager {
+        private static IBinder sDeviceIdleService;
+
+        @Implementation
+        public static IBinder getService(String name) {
+            return "deviceidle".equals(name)
+                    ? sDeviceIdleService
+                    : ShadowServiceManager.getService(name);
+        }
+
+        @Resetter
+        public static void resetDeviceIdleService() {
+            sDeviceIdleService = null;
+        }
+    }
+}
