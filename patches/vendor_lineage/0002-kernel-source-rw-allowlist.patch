diff --git a/config/BoardConfigLineage.mk b/config/BoardConfigLineage.mk
index 94564ae..406da3b 100644
--- a/config/BoardConfigLineage.mk
+++ b/config/BoardConfigLineage.mk
@@ -4,6 +4,20 @@
 # build-manifest.xml
 BUILD_BROKEN_SRC_DIR_RW_ALLOWLIST := $(abspath .repo/manifests.git)
 
+# The Qualcomm video-driver external module creates temporary `driver`
+# symlinks under its own source directory while the kernel module is built.
+# Android 17 mounts the rest of the source tree read-only, so allow only this
+# one source subtree instead of opting the entire tree out of the sandbox.
+BUILD_BROKEN_SRC_DIR_RW_ALLOWLIST += $(abspath kernel/xiaomi/sm8735-modules/qcom/opensource/video-driver)
+
+# The camera module generates cam_generated_h beside its source files.
+BUILD_BROKEN_SRC_DIR_RW_ALLOWLIST += $(abspath kernel/xiaomi/sm8735-modules/qcom/opensource/camera-kernel)
+
+# The custom WLAN wrapper updates its ABI cache and builds objects in-source.
+BUILD_BROKEN_SRC_DIR_RW_ALLOWLIST += $(abspath kernel/xiaomi/konoha-abi)
+BUILD_BROKEN_SRC_DIR_RW_ALLOWLIST += $(abspath kernel/xiaomi/sm8735-modules/qcom/opensource/wlan/qcacld-3.0)
+BUILD_BROKEN_SRC_DIR_RW_ALLOWLIST += $(abspath kernel/xiaomi/sm8735-modules/qcom/opensource/wlan/qca-wifi-host-cmn)
+
 # Recovery
 BOARD_USES_FULL_RECOVERY_IMAGE ?= true
 
