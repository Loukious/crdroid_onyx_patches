diff --git a/build/tasks/kernel.mk b/build/tasks/kernel.mk
index a36edcb8f90fd075c539b100e772f03280789095..0f19e2c4b072717803cb5c8b9ee465d3065321e7 100644
--- a/build/tasks/kernel.mk
+++ b/build/tasks/kernel.mk
@@ -769,7 +769,29 @@ else
 KERNEL_REPO_MANIFEST := $(abspath $(KERNEL_PATH)):$(abspath $(KERNEL_OUT)/manifest.xml)
 endif
 
+ifneq ($(TARGET_KERNEL_PORT_BUILD),)
+# Android refreshes this real input on every build invocation. Revalidate
+# source/KernelSU inputs each time; Kleaf reuses unchanged compiled outputs.
+$(TARGET_PREBUILT_INT_KERNEL): $(BUILD_DATETIME_FILE) $(TARGET_KERNEL_PORT_BUILD)
+endif
+
 $(TARGET_PREBUILT_INT_KERNEL): $(DEPMOD) $(KERNEL_MODULES_PARTITION_FILE_LIST) $(SYSTEM_KERNEL_MODULES_PARTITION_FILE_LIST)
+ifneq ($(TARGET_KERNEL_PORT_BUILD),)
+	@echo "Building Onyx GKI, all matching modules and device trees from source"
+	$(hide) python3 $(TARGET_KERNEL_PORT_BUILD) --source $(KERNEL_PATH) \
+		--workspace $(abspath $(KERNEL_BAZEL_OUT)) --output $(abspath $(KERNEL_OUT)) \
+		--jobs $(TARGET_KERNEL_PORT_JOBS) --memory-mb $(TARGET_KERNEL_PORT_MEMORY_MB)
+	$(hide) for dir in "$(SYSTEM_KERNEL_MODULES_OUT)" "$(KERNEL_MODULES_OUT)" "$(KERNEL_VENDOR_RAMDISK_MODULES_OUT)" "$(KERNEL_RECOVERY_MODULES_OUT)"; do \
+		case "$$dir" in "$(PRODUCT_OUT)"/*) rm -f "$$dir"/lib/modules/*.ko ;; *) echo "Invalid module output directory: $$dir" >&2; exit 1 ;; esac; \
+	done
+	$(hide) sed -i -E '/^lib\/modules\/(.*\.ko|modules\.(alias|dep|load|softdep))$$/d' $(KERNEL_MODULES_PARTITION_FILE_LIST) $(SYSTEM_KERNEL_MODULES_PARTITION_FILE_LIST)
+	$(call build-image-kernel-modules-lineage,$$(sed 's|^|$(KERNEL_OUT)/|' $(KERNEL_OUT)/system_dlkm.modules),$(SYSTEM_KERNEL_MODULES_OUT),$(SYSTEM_KERNEL_MODULE_MOUNTPOINT)/,$(SYSTEM_KERNEL_DEPMOD_STAGING_DIR),$$(cat $(KERNEL_OUT)/system_dlkm.modules.load),,$(SYSTEM_KERNEL_MODULES_PARTITION_FILE_LIST),)
+	$(call build-image-kernel-modules-lineage,$$(sed 's|^|$(KERNEL_OUT)/|' $(KERNEL_OUT)/vendor_dlkm.modules),$(KERNEL_MODULES_OUT),$(KERNEL_MODULE_MOUNTPOINT)/,$(KERNEL_DEPMOD_STAGING_DIR),$$(cat $(KERNEL_OUT)/vendor_dlkm.modules.load),,$(KERNEL_MODULES_PARTITION_FILE_LIST),$(SYSTEM_KERNEL_DEPMOD_STAGING_DIR)/lib/modules/0.0/$(SYSTEM_KERNEL_MODULE_MOUNTPOINT))
+	$(call build-image-kernel-modules-lineage,$$(sed 's|^|$(KERNEL_OUT)/|' $(KERNEL_OUT)/vendor_ramdisk.modules),$(KERNEL_VENDOR_RAMDISK_MODULES_OUT),,$(KERNEL_VENDOR_RAMDISK_DEPMOD_STAGING_DIR),$$(cat $(KERNEL_OUT)/vendor_ramdisk.modules.load),,,)
+	$(call build-image-kernel-modules-lineage,$$(sed 's|^|$(KERNEL_OUT)/|' $(KERNEL_OUT)/vendor_ramdisk.modules),$(KERNEL_RECOVERY_MODULES_OUT),,$(KERNEL_RECOVERY_DEPMOD_STAGING_DIR),$$(cat $(KERNEL_OUT)/vendor_ramdisk.modules.load.recovery),,,)
+	$(hide) cp $(KERNEL_OUT)/vendor_ramdisk.modules.load.recovery $(KERNEL_VENDOR_RAMDISK_MODULES_OUT)/lib/modules/modules.load.recovery
+	$(hide) cp $(KERNEL_OUT)/vendor_ramdisk.modules.load.recovery $(KERNEL_RECOVERY_MODULES_OUT)/lib/modules/modules.load.recovery
+else
 	@echo "Building $(BOARD_KERNEL_IMAGE_NAME)"
 	$(hide) rm -rf $(KERNEL_OUT)
 	@mkdir -p $(KERNEL_OUT) $(KERNEL_BAZEL_OUT)
@@ -801,6 +823,8 @@ $(TARGET_PREBUILT_INT_KERNEL): $(DEPMOD) $(KERNEL_MODULES_PARTITION_FILE_LIST) $
 	vendor_modules=$$(comm -23 <(find $(KERNEL_OUT) -maxdepth 1 -type f -name '*.ko' | awk -F'/' '{ print $$NF }' | sort) <(awk -F'/' '{ print $$NF }' $(KERNEL_OUT)/system_dlkm.modules.load | sort) | sed 's|^|$(KERNEL_OUT)/|'); \
 	($(call build-image-kernel-modules-lineage,$$vendor_modules,$(KERNEL_MODULES_OUT),$(KERNEL_MODULE_MOUNTPOINT)/,$(KERNEL_DEPMOD_STAGING_DIR),$(BOARD_VENDOR_KERNEL_MODULES_LOAD),,$(KERNEL_MODULES_PARTITION_FILE_LIST),$(SYSTEM_KERNEL_DEPMOD_STAGING_DIR)/lib/modules/0.0/$(SYSTEM_KERNEL_MODULE_MOUNTPOINT)))
 
+endif
+
 ifeq ($(BOARD_INCLUDE_DTB_IN_BOOTIMG),true)
 $(INSTALLED_DTBIMAGE_TARGET): $(TARGET_PREBUILT_INT_KERNEL)
 	@rm -f $@
