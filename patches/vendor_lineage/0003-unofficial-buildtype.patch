diff --git a/config/version.mk b/config/version.mk
index 2ee2d5d4..91e6a850 100644
--- a/config/version.mk
+++ b/config/version.mk
@@ -4,11 +4,20 @@ PRODUCT_VERSION_MINOR = 0
 # Increase CR Version with each major release.
 CR_VERSION := 12.11
 
+# Unofficial build marker. This tree is not a crDroid release: it carries a
+# local patch set and a prebuilt Kono-Ha kernel, so it must not present itself
+# as one. UNOFFICIAL is deliberately outside the
+# RELEASE/NIGHTLY/SNAPSHOT/EXPERIMENTAL set that
+# vendor/lineage/build/tasks/kernel.mk:231 refuses a prebuilt kernel for.
+LINEAGE_BUILDTYPE := UNOFFICIAL
+
 # Internal version
-LINEAGE_VERSION := crDroidAndroid-$(PRODUCT_VERSION_MAJOR).$(PRODUCT_VERSION_MINOR)-$(shell date +%Y%m%d)-$(LINEAGE_BUILD)-v$(CR_VERSION)
+# The suffix goes last on purpose: createjson.sh reads the release version out
+# of the zip name with `cut -d'-' -f5`, which is still v$(CR_VERSION).
+LINEAGE_VERSION := crDroidAndroid-$(PRODUCT_VERSION_MAJOR).$(PRODUCT_VERSION_MINOR)-$(shell date +%Y%m%d)-$(LINEAGE_BUILD)-v$(CR_VERSION)-$(LINEAGE_BUILDTYPE)
 
 # Display version
-LINEAGE_DISPLAY_VERSION := v$(CR_VERSION)-$(shell date +%Y%m%d)
+LINEAGE_DISPLAY_VERSION := v$(CR_VERSION)-$(shell date +%Y%m%d)-$(LINEAGE_BUILDTYPE)
 
 # LineageOS version properties
 PRODUCT_PRODUCT_PROPERTIES += \
