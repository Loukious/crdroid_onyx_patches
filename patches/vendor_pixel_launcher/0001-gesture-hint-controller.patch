diff --git a/apps/PixelLauncherGestureHintController/src/com/loukious/pixellauncher/gesturehint/GestureHintController.java b/apps/PixelLauncherGestureHintController/src/com/loukious/pixellauncher/gesturehint/GestureHintController.java
new file mode 100644
index 0000000..907ee73
--- /dev/null
+++ b/apps/PixelLauncherGestureHintController/src/com/loukious/pixellauncher/gesturehint/GestureHintController.java
@@ -0,0 +1,130 @@
+/*
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.loukious.pixellauncher.gesturehint;
+
+import android.app.ActivityManager;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.om.OverlayInfo;
+import android.content.om.OverlayManager;
+import android.database.ContentObserver;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.UserHandle;
+import android.util.Log;
+
+import lineageos.providers.LineageSettings;
+
+final class GestureHintController {
+
+    private static final String TAG = "PixelGestureHint";
+
+    private static final String OVERLAY_PACKAGE =
+            "com.google.android.apps.nexuslauncher.overlay.nogesturehint";
+
+    private static GestureHintController sInstance;
+
+    private final ContentResolver mContentResolver;
+    private final OverlayManager mOverlayManager;
+
+    private boolean mObserverRegistered;
+
+    private final ContentObserver mNavigationHintObserver =
+            new ContentObserver(new Handler(Looper.getMainLooper())) {
+                @Override
+                public void onChange(boolean selfChange) {
+                    syncCurrentUser();
+                }
+
+                @Override
+                public void onChange(boolean selfChange, Uri uri) {
+                    syncCurrentUser();
+                }
+            };
+
+    private GestureHintController(Context context) {
+        final Context applicationContext = context.getApplicationContext();
+
+        mContentResolver = applicationContext.getContentResolver();
+        mOverlayManager =
+                applicationContext.getSystemService(OverlayManager.class);
+    }
+
+    static synchronized GestureHintController getInstance(Context context) {
+        if (sInstance == null) {
+            sInstance = new GestureHintController(context);
+        }
+
+        return sInstance;
+    }
+
+    synchronized void start() {
+        if (!mObserverRegistered) {
+            try {
+                mContentResolver.registerContentObserver(
+                        LineageSettings.System.getUriFor(
+                                LineageSettings.System.NAVIGATION_BAR_HINT),
+                        false,
+                        mNavigationHintObserver,
+                        UserHandle.USER_ALL);
+
+                mObserverRegistered = true;
+            } catch (RuntimeException e) {
+                Log.w(TAG, "Unable to observe navigation hint setting", e);
+            }
+        }
+
+        syncCurrentUser();
+    }
+
+    private void syncCurrentUser() {
+        if (mOverlayManager == null) {
+            return;
+        }
+
+        try {
+            final int userId = ActivityManager.getCurrentUser();
+            final UserHandle userHandle = UserHandle.of(userId);
+
+            final OverlayInfo overlayInfo = mOverlayManager.getOverlayInfo(
+                    OVERLAY_PACKAGE,
+                    userHandle);
+
+            if (overlayInfo == null
+                    || overlayInfo.state == OverlayInfo.STATE_MISSING_TARGET) {
+                return;
+            }
+
+            final boolean navigationHintEnabled =
+                    LineageSettings.System.getIntForUser(
+                            mContentResolver,
+                            LineageSettings.System.NAVIGATION_BAR_HINT,
+                            1,
+                            userId) != 0;
+
+            final boolean shouldEnableOverlay = !navigationHintEnabled;
+
+            if (overlayInfo.isEnabled() == shouldEnableOverlay) {
+                return;
+            }
+
+            mOverlayManager.setEnabled(
+                    OVERLAY_PACKAGE,
+                    shouldEnableOverlay,
+                    userHandle);
+
+            Log.i(TAG,
+                    (shouldEnableOverlay ? "Enabled " : "Disabled ")
+                            + OVERLAY_PACKAGE
+                            + " for user "
+                            + userId);
+        } catch (SecurityException e) {
+            Log.w(TAG, "Permission denied while changing overlay", e);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Unable to synchronize gesture hint overlay", e);
+        }
+    }
+}
diff --git a/apps/PixelLauncherGestureHintController/src/com/loukious/pixellauncher/gesturehint/StartupReceiver.java b/apps/PixelLauncherGestureHintController/src/com/loukious/pixellauncher/gesturehint/StartupReceiver.java
