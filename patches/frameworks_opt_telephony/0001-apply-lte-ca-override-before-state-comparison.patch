+    private void assertLtePollNotifications(Boolean forceLteCa) {
+        String key = Settings.Global.FORCE_LTE_CA + "_" + PHONE_ID;
+        String original = Settings.Global.getString(mContext.getContentResolver(), key);
+        try {
+            Settings.Global.putString(mContext.getContentResolver(), key,
+                    forceLteCa == null ? null : (forceLteCa ? "1" : "0"));
+            processAllMessages();
+
+            CellIdentityLte cell = new CellIdentityLte(1, 1, 5, 1, new int[] {1},
+                    10000, "001", "01", "test", "tst", Collections.emptyList(), null);
+            sendRegStateUpdateForLteCellId(cell);
+            ServiceState previous = new ServiceState(sst.mSS);
+            assertEquals(forceLteCa, previous.getForceLteCA());
+
+            sst.registerForServiceStateChanged(mTestHandler, EVENT_SERVICE_STATE_CHANGED, null);
+            clearInvocations(mTestHandler);
+            sendRegStateUpdateForLteCellId(cell);
+
+            assertEquals(previous, sst.mSS);
+            verify(mTestHandler, never()).sendMessageAtTime(any(Message.class), anyLong());
+
+            // A genuine cell change must still reach the same listeners.
+            CellIdentityLte nextCell = new CellIdentityLte(2, 2, 5, 1, new int[] {1},
+                    10000, "001", "01", "test", "tst", Collections.emptyList(), null);
+            sendRegStateUpdateForLteCellId(nextCell);
+            assertEquals(forceLteCa, sst.mSS.getForceLteCA());
+            verify(mTestHandler, times(1)).sendMessageAtTime(any(Message.class), anyLong());
+        } finally {
+            sst.unregisterForServiceStateChanged(mTestHandler);
+            Settings.Global.putString(mContext.getContentResolver(), key, original);
+            processAllMessages();
+        }
+    }
