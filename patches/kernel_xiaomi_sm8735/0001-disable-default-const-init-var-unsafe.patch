diff --git a/scripts/Makefile.extrawarn b/scripts/Makefile.extrawarn
index 0ea3281a92e1..4f634cb875f0 100644
--- a/scripts/Makefile.extrawarn
+++ b/scripts/Makefile.extrawarn
@@ -26,6 +26,11 @@ KBUILD_CPPFLAGS-$(CONFIG_WERROR) += -Werror
 KBUILD_CPPFLAGS += $(KBUILD_CPPFLAGS-y)
 KBUILD_CFLAGS-$(CONFIG_CC_NO_ARRAY_BOUNDS) += -Wno-array-bounds
 
+# clang 21 (A17 prebuilts) warns when a {} initializer default-initializes an
+# object whose typeof() resolves to a const-qualified scalar; dozens of core
+# files (fs/verity, bpf, io_uring, net) trip it under CONFIG_WERROR=y.
+KBUILD_CFLAGS += $(call cc-disable-warning, default-const-init-var-unsafe)
+
 ifdef CONFIG_CC_IS_CLANG
 # The kernel builds with '-std=gnu11' so use of GNU extensions is acceptable.
 KBUILD_CFLAGS += -Wno-gnu
