 	NLA_PUT_U32(msg, NL80211_ATTR_VENDOR_SUBCMD, subcmd);
@@ -110,13 +119,13 @@ static int handle_vendor(struct nl80211_state *state,
 		if (file != stdin)
 			fclose(file);
 	} else
-		count = read_hex(argc - 2, &argv[2], buf, sizeof(buf));
+		count = read_hex(argc - data_arg, &argv[data_arg], buf, sizeof(buf));
 
 	if (count < 0)
 		return -EINVAL;
 
 	if (count > 0)
