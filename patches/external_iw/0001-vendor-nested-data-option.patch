+		NLA_PUT(msg, data_type, count, buf);
 
 	return 0;
 
@@ -142,6 +151,6 @@ static int handle_vendor_recv_bin(struct nl80211_state *state,
 	return handle_vendor(state, msg, argc, argv, id);
 }
 
