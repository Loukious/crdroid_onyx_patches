diff --git a/vendor.c b/vendor.c
index d203d85..1b8c76f 100644
--- a/vendor.c
+++ b/vendor.c
@@ -78,6 +78,8 @@ static int handle_vendor(struct nl80211_state *state,
 {
 	unsigned int oui;
 	unsigned int subcmd;
+	unsigned int data_arg = 2;
+	int data_type = NL80211_ATTR_VENDOR_DATA;
 	char buf[2048] = {};
 	int res, count = 0;
 	FILE *file = NULL;
@@ -97,10 +99,17 @@ static int handle_vendor(struct nl80211_state *state,
 		return 2;
 	}
 
