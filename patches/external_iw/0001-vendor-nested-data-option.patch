+COMMAND(vendor, send, "<oui> <subcmd> [--nested] <filename|-|hex data>", NL80211_CMD_VENDOR, 0, CIB_NETDEV, handle_vendor, "Use --nested when the payload contains Netlink attributes; raw data is the default.");
+COMMAND(vendor, recv, "<oui> <subcmd> [--nested] <filename|-|hex data>", NL80211_CMD_VENDOR, 0, CIB_NETDEV, handle_vendor_recv, "Use --nested when the payload contains Netlink attributes; raw data is the default.");
+COMMAND(vendor, recvbin, "<oui> <subcmd> [--nested] <filename|-|hex data>", NL80211_CMD_VENDOR, 0, CIB_NETDEV, handle_vendor_recv_bin, "Use --nested when the payload contains Netlink attributes; raw data is the default.");
