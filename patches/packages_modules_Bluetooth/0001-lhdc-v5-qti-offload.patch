+bool lhdc_offloading_capability_match(const LhdcCapabilities& capability,
+                                      const LhdcConfiguration& config) {
+  const bool unsupported_feature =
+          (config.llacEnable && !capability.llacEnable) ||
+          (config.losslessEnable && !capability.losslessEnable) ||
+          (config.jasEnable && !capability.jasEnable) ||
+          (config.xmsaEnable && !capability.xmsaEnable);
+  const bool channel_split_supported =
+          config.channelSplitMode == LhdcChannelSplitMode::UNKNOWN ||
+          ContainedInVector(capability.channelSplitMode, config.channelSplitMode);
+
+  if (!ContainedInVector(capability.channelMode, config.channelMode) ||
+      !ContainedInVector(capability.qualityIndex, config.qualityIndex) ||
+      !ContainedInVector(capability.bitsPerSample, static_cast<uint8_t>(config.bitsPerSample)) ||
+      !ContainedInVector(capability.sampleRateHz, config.sampleRateHz) ||
+      !ContainedInVector(capability.version, config.version) ||
+      !ContainedInVector(capability.mode, config.mode) ||
+      !ContainedInVector(capability.maxTargetBitrate, config.maxTargetBitrate) ||
+      !ContainedInVector(capability.minTargetBitrate, config.minTargetBitrate) ||
+      !channel_split_supported || unsupported_feature) {
+    log::warn("software LHDC codec={} capability={}", config.toString(), capability.toString());
+    return false;
+  }
+  log::info("offloading LHDC codec={} capability={}", config.toString(), capability.toString());
+  return true;
+}
