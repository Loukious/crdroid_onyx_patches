+class A2dpCodecConfigAptxAdaptive : public A2dpCodecConfig {
+public:
+  A2dpCodecConfigAptxAdaptive(btav_a2dp_codec_priority_t codec_priority);
+  virtual ~A2dpCodecConfigAptxAdaptive();
+
+  bool init() override;
