+bool A2DP_VendorIsLosslessConfigAptxAdaptive(const uint8_t* p_codec_info) {
+  tA2DP_APTX_ADAPTIVE_CIE cie = {};
+  if (!A2DP_GetAptxAdaptiveCIE(p_codec_info, &cie)) {
+    return false;
+  }
+
+  const uint32_t features = cie.aptx_data.aptx_adaptive_sup_features;
+  return cie.sampleRate == A2DP_APTX_ADAPTIVE_SAMPLERATE_44100 &&
+         cie.aptx_data.cap_ext_ver_num == A2DP_APTX_ADAPTIVE_CAP_EXT_VER_NUM &&
+         (features & A2DP_APTX_ADAPTIVE_SOURCE_ENCODER_R2_2_SUPPORTED) != 0 &&
+         (features & A2DP_APTX_ADAPTIVE_SINK_DECODER_R2_2_SUPPORTED) != 0;
+}
