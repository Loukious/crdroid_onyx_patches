+            .wrapping_div(::core::mem::size_of::<u32>() as libc::c_ulong)
+    {
+        fdata_all_buffer.logarithm_by_2_tbl[index] =
+            (LOG_2_TABLE[index] >> 2_i32) ^ 21930 as libc::c_int as u32;
+        index += 1;
+    }
