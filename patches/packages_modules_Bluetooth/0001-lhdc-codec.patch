+    }
+    lhdc_config.maxTargetBitrate = static_cast<LhdcMaxTargetBitrate>(codec_info[kLhdcP7] & 0x30);
+    lhdc_config.minTargetBitrate =
+            (codec_info[kLhdcP8] & 0x20) != 0
