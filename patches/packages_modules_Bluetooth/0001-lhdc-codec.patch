+template <typename T>
+static bool load_lhdcv5_function(T* function, const char* symbol_name) {
+  dlerror();
+  void* symbol = dlsym(lhdcv5_encoder_library, symbol_name);
+  const char* error = dlerror();
+  if (error != nullptr) {
+    log::error("Cannot load {} from {}: {}", symbol_name, kLhdcv5EncoderLibrary, error);
+    return false;
+  }
+  *function = reinterpret_cast<T>(symbol);
+  return true;
+}
