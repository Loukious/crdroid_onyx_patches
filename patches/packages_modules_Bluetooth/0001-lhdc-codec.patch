+    } else if fdata_all_buffer.enc_pixel_size_byte <= 120_i32 {
+        68812_i32
+            - ((68812_i32 - 65536 as libc::c_int) * (fdata_all_buffer.enc_pixel_size_byte - 50_i32)
+                + 35_i32)
+                / (120_i32 - 50 as libc::c_int)
