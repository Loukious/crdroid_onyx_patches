diff --git a/system/stack/btm/btm_qhs.cc b/system/stack/btm/btm_qhs.cc
new file mode 100644
index 0000000000..acea5a8ba2
--- /dev/null
+++ b/system/stack/btm/btm_qhs.cc
@@ -0,0 +1,389 @@
+/*
