+//
+// A2DP Codec API for aptX-adaptive
+//
+
+#ifndef A2DP_VENDOR_APTX_ADAPTIVE_H
+#define A2DP_VENDOR_APTX_ADAPTIVE_H
+
+#include "a2dp_codec_api.h"
