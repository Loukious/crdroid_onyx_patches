+            + ((scratch[7].r as i64 * ya.r as i64 + (1 << (31 - 1)) as i64) >> 31) as i32
+            + ((scratch[8].r as i64 * yb.r as i64 + (1 << (31 - 1)) as i64) >> 31) as i32;
