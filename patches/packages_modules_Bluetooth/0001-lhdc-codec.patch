+        scratch[3].r = ((f_out_3[0].r as i64 * (twiddles[(3 * u).wrapping_mul(fstride)]).r as i64
+            - f_out_3[0].i as i64 * (twiddles[(3 * u).wrapping_mul(fstride)]).i as i64
