+        scratch[2].r = ((f_out_2[0].r as i64 * (twiddles[(2 * u).wrapping_mul(fstride)]).r as i64
+            - f_out_2[0].i as i64 * (twiddles[(2 * u).wrapping_mul(fstride)]).i as i64
