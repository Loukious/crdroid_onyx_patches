+         cie.aptx_data.cap_ext_ver_num == A2DP_APTX_ADAPTIVE_CAP_EXT_VER_NUM &&
+         (features & A2DP_APTX_ADAPTIVE_SOURCE_ENCODER_R2_2_SUPPORTED) != 0 &&
+         (features & A2DP_APTX_ADAPTIVE_SINK_DECODER_R2_2_SUPPORTED) != 0;
