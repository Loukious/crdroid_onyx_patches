+bool A2dpCodecConfigLhdcV2::init() {
+  // Load the encoder
+  if (!A2DP_VendorLoadEncoderLhdcV2()) {
+    LOG_ERROR(LOG_TAG, "%s: cannot load the encoder", __func__);
+    return false;
+  }
+
+  return true;
+}
