+bool A2DP_VendorLoadEncoderLhdcV5(void) {
+  if (lhdcv5_encoder_library != nullptr) {
+    return true;
+  }
+
+  // Initialize the control block
+  memset(&a2dp_lhdc_encoder_cb, 0, sizeof(a2dp_lhdc_encoder_cb));
+
+  lhdcv5_encoder_library = dlopen(kLhdcv5EncoderLibrary, RTLD_NOW | RTLD_LOCAL);
+  if (lhdcv5_encoder_library == nullptr) {
+    log::error("Cannot open {}: {}", kLhdcv5EncoderLibrary, dlerror());
+    return false;
+  }
+
+  if (!load_lhdcv5_function(&lhdcv5_free_handle, "lhdcv5BT_free_handle") ||
+      !load_lhdcv5_function(&lhdcv5_get_handle, "lhdcv5BT_get_handle") ||
+      !load_lhdcv5_function(&lhdcv5_get_bitrate, "lhdcv5BT_get_bitrate") ||
+      !load_lhdcv5_function(&lhdcv5_set_bitrate, "lhdcv5BT_set_bitrate") ||
+      !load_lhdcv5_function(&lhdcv5_set_max_bitrate, "lhdcv5BT_set_max_bitrate") ||
+      !load_lhdcv5_function(&lhdcv5_set_min_bitrate, "lhdcv5BT_set_min_bitrate") ||
+      !load_lhdcv5_function(&lhdcv5_adjust_bitrate, "lhdcv5BT_adjust_bitrate") ||
+      !load_lhdcv5_function(&lhdcv5_init_encoder, "lhdcv5BT_init_encoder") ||
+      !load_lhdcv5_function(&lhdcv5_get_block_size, "lhdcv5BT_get_block_Size") ||
+      !load_lhdcv5_function(&lhdcv5_encode, "lhdcv5BT_encode")) {
+    A2DP_VendorUnloadEncoderLhdcV5();
+    return false;
+  }
+  return true;
+}
+
+bool A2DP_VendorUnloadEncoderLhdcV5(void) {
+  bool success = true;
+  if (a2dp_lhdc_encoder_cb.has_lhdc_handle && lhdcv5_free_handle != nullptr) {
+    int32_t result = lhdcv5_free_handle(a2dp_lhdc_encoder_cb.lhdc_handle);
+    if (result != LHDC_FRET_SUCCESS) {
+      log::error("Failed to free LHDC V5 encoder handle: {}", result);
+      success = false;
+    }
+  }
+  memset(&a2dp_lhdc_encoder_cb, 0, sizeof(a2dp_lhdc_encoder_cb));
+
+  lhdcv5_free_handle = nullptr;
+  lhdcv5_get_handle = nullptr;
+  lhdcv5_get_bitrate = nullptr;
+  lhdcv5_set_bitrate = nullptr;
+  lhdcv5_set_max_bitrate = nullptr;
+  lhdcv5_set_min_bitrate = nullptr;
+  lhdcv5_adjust_bitrate = nullptr;
+  lhdcv5_init_encoder = nullptr;
+  lhdcv5_get_block_size = nullptr;
+  lhdcv5_encode = nullptr;
+
+  if (lhdcv5_encoder_library != nullptr) {
+    if (dlclose(lhdcv5_encoder_library) != 0) {
+      log::error("Cannot close {}: {}", kLhdcv5EncoderLibrary, dlerror());
+      success = false;
+    }
+    lhdcv5_encoder_library = nullptr;
+  }
+  return success;
+}
